---
/**Minimal layout for embeddable chart pages — no header, nav, or footer.*/
import '../styles/global.css';
import '../styles/brand-fonts';
import { HEADLINE } from '../lib/budget-year';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Pittsburgh Budget Explorer chart embed.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <title>{title} | Pittsburgh Budget Explorer</title>
    <style>
      body { margin: 0; padding: 0; background: white; }
    </style>
  </head>
  <body class="text-gray-900">
    <main class="px-4 py-3">
      <slot />
    </main>
    <footer class="px-4 pb-3 pt-1 text-xs text-gray-400 flex items-center justify-between">
      <span>
        Source: <a href="https://pgh-budget-explorer.netlify.app" target="_blank" rel="noopener" class="text-ps-blue-500 hover:text-ps-blue-700 underline">Pittsburgh Budget Explorer</a>
      </span>
      <span>City of Pittsburgh {HEADLINE.fiscalLabel} Budget</span>
    </footer>
  </body>
</html>
