---
/**Layout for curated story pages — reading-friendly typography, minimal chrome.*/
import '../styles/global.css';
import '../styles/brand-fonts';
import YearNotice from '../components/YearNotice.astro';
import { ARCHIVE_YEARS, BUDGET_2026, yearPath, type BudgetYear } from '../lib/budget-year';

interface Props {
  title: string;
  subtitle: string;
  description: string;
  date: string;
  /** Budget the story's figures come from; stories are pinned to an archive year. */
  budgetYear?: BudgetYear;
}

const { title, subtitle, description, date, budgetYear = BUDGET_2026 } = Astro.props;
const archiveLinks = ARCHIVE_YEARS.map((y) => ({
  href: yearPath({ budgetYear: y, path: '/operating/' }),
  label: `${y.year} archive`,
  prefix: `${y.routePrefix}/`,
}));
const canonicalUrl = Astro.url.href;

const path = Astro.url.pathname;
function isActive(href: string): boolean {
  return path === href || (path.startsWith(href) && href !== '/');
}
function navClass(href: string): string {
  return isActive(href)
    ? 'text-white font-semibold border-b-2 border-ps-yellow-100 pb-0.5'
    : 'text-gray-300 hover:text-white';
}
function dropdownParentClass(hrefs: string[]): string {
  return hrefs.some(h => isActive(h))
    ? 'text-white font-semibold'
    : 'text-gray-300 hover:text-white';
}
function dropdownItemClass(href: string): string {
  return isActive(href)
    ? 'block px-3 py-1.5 text-white bg-neutral-700 font-semibold'
    : 'block px-3 py-1.5 text-gray-200 hover:bg-neutral-700 hover:text-white';
}

const storiesHrefs = ['/stories/', '/departments/'];
const budgetsHrefs = ['/operating/', '/capital/', '/flow/', '/trends/', '/cross-year/', ...archiveLinks.map((a) => a.prefix)];
const exploreHrefs = ['/compare/', '/explorer/', '/personnel/', '/embed/', '/glossary/'];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} | Pittsburgh Budget Explorer`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="article" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%231277E2'/><text x='16' y='22' font-size='15' font-family='system-ui' font-weight='bold' fill='white' text-anchor='middle'>PS</text></svg>" />
    <title>{title} | Pittsburgh Budget Explorer</title>
  </head>
  <body class="min-h-screen bg-white text-gray-900">
    <header class="bg-ps-ink text-white px-6 py-3">
      <div class="max-w-6xl mx-auto">
        <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
          <a href="/" class="flex shrink-0 items-center gap-3 group">
            <img src="/images/public-source-logo-white.png" alt="Pittsburgh's Public Source" width="150" height="34" class="h-8 w-auto sm:h-9" />
            <span class="border-l border-gray-500 pl-3"><img src="/images/budget-explorer-wordmark-white.png" alt="Budget Explorer" width="187" height="36" class="h-7 w-auto sm:h-8" /></span>
          </a>
          <nav class="flex items-center gap-4 text-sm" aria-label="Main navigation">
            <a href="/brief/" class={navClass('/brief/')}>Brief</a>

            <div class="nav-dropdown relative">
              <a href="/stories/" class={`nav-dropdown-trigger ${dropdownParentClass(storiesHrefs)}`} aria-expanded="false" aria-haspopup="true">
                Stories <span class="text-[0.6rem] ml-0.5" aria-hidden="true">&#9662;</span>
              </a>
              <div class="nav-dropdown-menu absolute top-full left-0 pt-2 hidden z-50">
                <div class="bg-neutral-800 rounded shadow-lg py-1 min-w-[10rem]">
                  <a href="/stories/" class={dropdownItemClass('/stories/')}>Stories</a>
                  <a href="/departments/" class={dropdownItemClass('/departments/')}>Departments</a>
                </div>
              </div>
            </div>

            <div class="nav-dropdown relative">
              <a href="/operating/" class={`nav-dropdown-trigger ${dropdownParentClass(budgetsHrefs)}`} aria-expanded="false" aria-haspopup="true">
                Budgets <span class="text-[0.6rem] ml-0.5" aria-hidden="true">&#9662;</span>
              </a>
              <div class="nav-dropdown-menu absolute top-full left-0 pt-2 hidden z-50">
                <div class="bg-neutral-800 rounded shadow-lg py-1 min-w-[12rem]">
                  <a href="/operating/" class={dropdownItemClass('/operating/')}>Operating</a>
                  <a href="/capital/" class={dropdownItemClass('/capital/')}>Capital</a>
                  <a href="/flow/" class={dropdownItemClass('/flow/')}>Money flow</a>
                  <a href="/trends/" class={dropdownItemClass('/trends/')}>Trends</a>
                  <a href="/cross-year/" class={dropdownItemClass('/cross-year/')}>Proposed vs adopted</a>
                  {archiveLinks.map((a) => (
                    <a href={a.href} class={dropdownItemClass(a.prefix)}>{a.label}</a>
                  ))}
                </div>
              </div>
            </div>

            <div class="nav-dropdown relative">
              <a href="/explorer/" class={`nav-dropdown-trigger ${dropdownParentClass(exploreHrefs)}`} aria-expanded="false" aria-haspopup="true">
                Explore <span class="text-[0.6rem] ml-0.5" aria-hidden="true">&#9662;</span>
              </a>
              <div class="nav-dropdown-menu absolute top-full left-0 pt-2 hidden z-50">
                <div class="bg-neutral-800 rounded shadow-lg py-1 min-w-[10rem]">
                  <a href="/explorer/" class={dropdownItemClass('/explorer/')}>Explorer</a>
                  <a href="/compare/" class={dropdownItemClass('/compare/')}>Compare</a>
                  <a href="/personnel/" class={dropdownItemClass('/personnel/')}>Personnel</a>
                  <a href="/embed/" class={dropdownItemClass('/embed/')}>Embeds</a>
                  <a href="/glossary/" class={dropdownItemClass('/glossary/')}>Glossary</a>
                </div>
              </div>
            </div>
          </nav>
        </div>
      </div>
    </header>

    <YearNotice budgetYear={budgetYear} />

    <article class="max-w-3xl mx-auto px-6 py-10">
      <header class="mb-10">
        <h1 class="text-4xl font-bold leading-tight mb-3">{title}</h1>
        <p class="text-xl text-gray-600 leading-relaxed">{subtitle}</p>
        <div class="mt-4 text-sm text-gray-400">
          <span>Data analysis by Pittsburgh Budget Explorer</span>
          <span class="mx-2">·</span>
          <time>{date}</time>
        </div>
      </header>

      <div class="story-content">
        <slot />
      </div>

      <footer class="mt-12 pt-6 border-t border-gray-200">
        <details class="mb-6">
          <summary class="text-sm font-medium text-gray-500 cursor-pointer hover:text-gray-700">Methodology</summary>
          <p class="mt-2 text-sm text-gray-500 leading-relaxed">
            All figures are extracted from the City of Pittsburgh's official {budgetYear.fiscalLabel} operating and capital budget documents
            using automated table extraction. Year-over-year comparisons use the {budgetYear.priorLabel} as baseline.
            For details on data extraction and known limitations, see the
            <a href="/about/" class="text-ps-blue-600 hover:underline">About page</a>.
          </p>
        </details>
        <div class="flex items-center gap-4 text-sm">
          <a href="/stories/" class="text-ps-blue-600 hover:underline">&larr; More stories</a>
          <a href="/brief/" class="text-ps-blue-600 hover:underline">Budget in brief</a>
          <a href="/" class="text-ps-blue-600 hover:underline">Full explorer</a>
        </div>
      </footer>
    </article>

    <style>
      .story-content :global(p) {
        @apply text-gray-700 leading-relaxed mb-4 text-lg;
      }
      .story-content :global(h2) {
        @apply text-2xl font-bold mt-10 mb-4;
      }
      .story-content :global(h3) {
        @apply text-xl font-semibold mt-8 mb-3;
      }
      .story-content :global(strong) {
        @apply text-gray-900;
      }
      .story-content :global(.chart-container) {
        @apply bg-gray-50 rounded-xl p-5 my-6 border;
      }
      .story-content :global(.callout) {
        @apply bg-ps-blue-50 border-l-4 border-ps-blue-500 p-4 my-6 text-ps-blue-900;
      }
      .story-content :global(.callout p) {
        @apply text-ps-blue-900 mb-0;
      }
    </style>
    <script is:inline>
      // Nav dropdown: open on hover/click, close on leave/outside click, keyboard accessible
      document.querySelectorAll('.nav-dropdown').forEach(dd => {
        const trigger = dd.querySelector('.nav-dropdown-trigger');
        const menu = dd.querySelector('.nav-dropdown-menu');
        function open() { menu.classList.remove('hidden'); trigger.setAttribute('aria-expanded', 'true'); }
        function close() { menu.classList.add('hidden'); trigger.setAttribute('aria-expanded', 'false'); }

        dd.addEventListener('mouseenter', open);
        dd.addEventListener('mouseleave', close);

        // Close on outside click
        document.addEventListener('click', (e) => { if (!dd.contains(e.target)) close(); });

        // Keyboard: Escape closes, arrow keys open and navigate items
        dd.addEventListener('keydown', (e) => {
          const items = menu.querySelectorAll('a:not(.nav-dropdown-trigger)');
          const idx = Array.from(items).indexOf(document.activeElement);
          if (e.key === 'Escape') { close(); trigger.focus(); }
          else if (e.key === 'ArrowDown') { e.preventDefault(); open(); items[Math.min(idx + 1, items.length - 1)].focus(); }
          else if (e.key === 'ArrowUp') { e.preventDefault(); items[Math.max(idx - 1, 0)].focus(); }
        });
      });
    </script>
  </body>
</html>
