---
import '../styles/global.css';
import '../styles/brand-fonts';
import YearNotice from '../components/YearNotice.astro';
import { type BudgetYear, HEADLINE, ARCHIVE_YEARS, yearPath } from '../lib/budget-year';

interface Props {
  title: string;
  description?: string;
  fullWidth?: boolean;
  ogTitle?: string;
  ogDescription?: string;
  /** Budget year the page shows; selects the proposed vs archive notice. */
  budgetYear?: BudgetYear;
  /** Path of this page in the current (headline) version, when one exists. */
  currentHref?: string;
}

const {
  title,
  description = `Explore the City of Pittsburgh ${HEADLINE.fiscalLabel} operating and capital budget data.`,
  fullWidth = false,
  ogTitle,
  ogDescription,
  budgetYear = HEADLINE,
  currentHref,
} = Astro.props;
const resolvedOgTitle = ogTitle || `${title} | Pittsburgh Budget Explorer`;
const resolvedOgDescription = ogDescription || description;
const canonicalUrl = Astro.url.href;

const path = Astro.url.pathname;
function isActive(href: string): boolean {
  return path === href || (path.startsWith(href) && href !== '/');
}
function navClass(href: string): string {
  return isActive(href)
    ? 'text-white font-semibold border-b-2 border-ps-yellow-100 pb-0.5'
    : 'text-gray-300 hover:text-white';
}
function dropdownParentClass(hrefs: string[]): string {
  return hrefs.some(h => isActive(h))
    ? 'text-white font-semibold'
    : 'text-gray-300 hover:text-white';
}
function dropdownItemClass(href: string): string {
  return isActive(href)
    ? 'block px-3 py-1.5 text-white bg-neutral-700 font-semibold'
    : 'block px-3 py-1.5 text-gray-200 hover:bg-neutral-700 hover:text-white';
}

const archiveLinks = ARCHIVE_YEARS.map((y) => ({
  href: yearPath({ budgetYear: y, path: '/operating/' }),
  label: `${y.year} archive`,
  prefix: `${y.routePrefix}/`,
}));
const budgetsHrefs = ['/operating/', '/capital/', '/flow/', '/trends/', ...archiveLinks.map((a) => a.prefix)];
const exploreHrefs = ['/personnel/', '/glossary/'];
// The departments are listed as a group on the operating index; there is no separate departments index.
const DEPARTMENTS_HREF = '/operating/#departments';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={resolvedOgTitle} />
    <meta property="og:description" content={resolvedOgDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%231277E2'/><text x='16' y='22' font-size='15' font-family='system-ui' font-weight='bold' fill='white' text-anchor='middle'>PS</text></svg>" />
    <title>{title} | Pittsburgh Budget Explorer</title>
  </head>
  <body class="min-h-screen bg-gray-50 text-gray-900">
    <header class="bg-ps-ink text-white px-6 py-3">
      <div class="max-w-6xl mx-auto">
        <div class="flex items-center justify-between">
          <a href="/" class="flex shrink-0 items-center gap-3 group">
            <img src="/images/public-source-logo-white.png" alt="Pittsburgh's Public Source" width="150" height="34" class="h-8 w-auto sm:h-9" />
            <span class="border-l border-gray-500 pl-3"><img src="/images/budget-explorer-wordmark-white.png" alt="Budget Explorer" width="187" height="36" class="h-7 w-auto sm:h-8" /></span>
          </a>
          <button id="mobile-nav-toggle" type="button" class="md:hidden inline-flex items-center justify-center p-2 rounded text-gray-200 hover:text-white hover:bg-neutral-800" aria-label="Open menu" aria-controls="mobile-nav" aria-expanded="false">
            <svg id="mobile-nav-icon-open" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
            <svg id="mobile-nav-icon-close" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
          <nav class="hidden md:flex items-center gap-4 text-sm" aria-label="Main navigation">
            <a href="/brief/" class={navClass('/brief/')}>Brief</a>

            <a href={DEPARTMENTS_HREF} class={navClass('/departments/')}>Departments</a>

            <div class="nav-dropdown relative">
              <a href="/operating/" class={`nav-dropdown-trigger ${dropdownParentClass(budgetsHrefs)}`} aria-expanded="false" aria-haspopup="true">
                Budgets <span class="text-[0.6rem] ml-0.5" aria-hidden="true">&#9662;</span>
              </a>
              <div class="nav-dropdown-menu absolute top-full left-0 pt-2 hidden z-50">
                <div class="bg-neutral-800 rounded shadow-lg py-1 min-w-[12rem]">
                  <a href="/operating/" class={dropdownItemClass('/operating/')}>Operating</a>
                  <a href="/capital/" class={dropdownItemClass('/capital/')}>Capital</a>
                  <a href="/flow/" class={dropdownItemClass('/flow/')}>Money flow</a>
                  <a href="/trends/" class={dropdownItemClass('/trends/')}>Trends</a>
                  {archiveLinks.map((a) => (
                    <a href={a.href} class={dropdownItemClass(a.prefix)}>{a.label}</a>
                  ))}
                </div>
              </div>
            </div>

            <div class="nav-dropdown relative">
              <a href="/personnel/" class={`nav-dropdown-trigger ${dropdownParentClass(exploreHrefs)}`} aria-expanded="false" aria-haspopup="true">
                Explore <span class="text-[0.6rem] ml-0.5" aria-hidden="true">&#9662;</span>
              </a>
              <div class="nav-dropdown-menu absolute top-full left-0 pt-2 hidden z-50">
                <div class="bg-neutral-800 rounded shadow-lg py-1 min-w-[10rem]">
                  <a href="/personnel/" class={dropdownItemClass('/personnel/')}>Personnel</a>
                  <a href="/glossary/" class={dropdownItemClass('/glossary/')}>Glossary</a>
                </div>
              </div>
            </div>
          </nav>
        </div>
        <nav id="mobile-nav" class="hidden md:hidden mt-3 pb-2 text-sm" aria-label="Mobile navigation">
          <a href="/brief/" class={`flex items-center min-h-[40px] px-2 py-2 rounded ${isActive('/brief/') ? 'bg-neutral-800 text-white font-semibold' : 'text-gray-200 hover:bg-neutral-800 hover:text-white'}`}>Brief</a>
          <a href={DEPARTMENTS_HREF} class={`flex items-center min-h-[40px] px-2 py-2 rounded ${isActive('/departments/') ? 'bg-neutral-800 text-white font-semibold' : 'text-gray-200 hover:bg-neutral-800 hover:text-white'}`}>Departments</a>
          <div class="mt-3">
            <div class="px-2 text-xs text-ps-yellow-100 font-semibold">Budgets</div>
            <a href="/operating/" class={`flex items-center min-h-[40px] px-2 py-2 rounded ${isActive('/operating/') ? 'bg-neutral-800 text-white font-semibold' : 'text-gray-200 hover:bg-neutral-800 hover:text-white'}`}>Operating</a>
            <a href="/capital/" class={`flex items-center min-h-[40px] px-2 py-2 rounded ${isActive('/capital/') ? 'bg-neutral-800 text-white font-semibold' : 'text-gray-200 hover:bg-neutral-800 hover:text-white'}`}>Capital</a>
            <a href="/flow/" class={`flex items-center min-h-[40px] px-2 py-2 rounded ${isActive('/flow/') ? 'bg-neutral-800 text-white font-semibold' : 'text-gray-200 hover:bg-neutral-800 hover:text-white'}`}>Money flow</a>
            <a href="/trends/" class={`flex items-center min-h-[40px] px-2 py-2 rounded ${isActive('/trends/') ? 'bg-neutral-800 text-white font-semibold' : 'text-gray-200 hover:bg-neutral-800 hover:text-white'}`}>Trends</a>
            {archiveLinks.map((a) => (
              <a href={a.href} class={`flex items-center min-h-[40px] px-2 py-2 rounded ${isActive(a.prefix) ? 'bg-neutral-800 text-white font-semibold' : 'text-gray-200 hover:bg-neutral-800 hover:text-white'}`}>{a.label}</a>
            ))}
          </div>
          <div class="mt-3">
            <div class="px-2 text-xs text-ps-yellow-100 font-semibold">Explore</div>
            <a href="/personnel/" class={`flex items-center min-h-[40px] px-2 py-2 rounded ${isActive('/personnel/') ? 'bg-neutral-800 text-white font-semibold' : 'text-gray-200 hover:bg-neutral-800 hover:text-white'}`}>Personnel</a>
            <a href="/glossary/" class={`flex items-center min-h-[40px] px-2 py-2 rounded ${isActive('/glossary/') ? 'bg-neutral-800 text-white font-semibold' : 'text-gray-200 hover:bg-neutral-800 hover:text-white'}`}>Glossary</a>
          </div>
        </nav>
      </div>
    </header>
    <YearNotice budgetYear={budgetYear} currentHref={currentHref} />
    <main class={fullWidth ? '' : 'max-w-6xl mx-auto px-6 py-8'}>
      <slot />
    </main>
    <script is:inline>
      // Mobile hamburger toggle
      (function() {
        const btn = document.getElementById('mobile-nav-toggle');
        const panel = document.getElementById('mobile-nav');
        const iconOpen = document.getElementById('mobile-nav-icon-open');
        const iconClose = document.getElementById('mobile-nav-icon-close');
        if (!btn || !panel) return;
        btn.addEventListener('click', () => {
          const isOpen = !panel.classList.contains('hidden');
          if (isOpen) {
            panel.classList.add('hidden');
            btn.setAttribute('aria-expanded', 'false');
            btn.setAttribute('aria-label', 'Open menu');
            iconOpen.classList.remove('hidden');
            iconClose.classList.add('hidden');
          } else {
            panel.classList.remove('hidden');
            btn.setAttribute('aria-expanded', 'true');
            btn.setAttribute('aria-label', 'Close menu');
            iconOpen.classList.add('hidden');
            iconClose.classList.remove('hidden');
          }
        });
      })();
    </script>
    <script is:inline>
      // Nav dropdown: open on hover/click, close on leave/outside click, keyboard accessible
      document.querySelectorAll('.nav-dropdown').forEach(dd => {
        const trigger = dd.querySelector('.nav-dropdown-trigger');
        const menu = dd.querySelector('.nav-dropdown-menu');
        function open() { menu.classList.remove('hidden'); trigger.setAttribute('aria-expanded', 'true'); }
        function close() { menu.classList.add('hidden'); trigger.setAttribute('aria-expanded', 'false'); }

        dd.addEventListener('mouseenter', open);
        dd.addEventListener('mouseleave', close);

        // Close on outside click
        document.addEventListener('click', (e) => { if (!dd.contains(e.target)) close(); });

        // Keyboard: Escape closes, arrow keys open and navigate items
        dd.addEventListener('keydown', (e) => {
          const items = menu.querySelectorAll('a:not(.nav-dropdown-trigger)');
          const idx = Array.from(items).indexOf(document.activeElement);
          if (e.key === 'Escape') { close(); trigger.focus(); }
          else if (e.key === 'ArrowDown') { e.preventDefault(); open(); items[Math.min(idx + 1, items.length - 1)].focus(); }
          else if (e.key === 'ArrowUp') { e.preventDefault(); items[Math.max(idx - 1, 0)].focus(); }
        });
      });
    </script>
    <footer class="text-center text-sm text-gray-500 py-6 border-t border-gray-200">
      <p>Data extracted from the City of Pittsburgh {HEADLINE.fiscalLabel} Operating &amp; Capital Budgets</p>
      <p class="mt-1"><a href="/about/" class="hover:text-ps-blue-600 underline">About this site</a> &mdash; how it was built, the role of AI, and important caveats</p>
      <p class="mt-3">
        <a href="https://lemaliconsulting.com" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-gray-400 hover:text-gray-600 transition-colors">
          <span>Built by</span>
          <img src="/images/lemali-wordmark.svg" alt="Lemali Consulting" class="h-4 inline-block" />
        </a>
      </p>
    </footer>
  </body>
</html>
