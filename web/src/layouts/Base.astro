---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  fullWidth?: boolean;
  ogTitle?: string;
  ogDescription?: string;
}

const { title, description = 'Explore the City of Pittsburgh FY2026 Operating and Capital Budget data.', fullWidth = false, ogTitle, ogDescription } = Astro.props;
const resolvedOgTitle = ogTitle || `${title} | Pittsburgh Budget Explorer`;
const resolvedOgDescription = ogDescription || description;
const canonicalUrl = Astro.url.href;

const path = Astro.url.pathname;
function isActive(href: string): boolean {
  return path === href || (path.startsWith(href) && href !== '/');
}
function navClass(href: string): string {
  return isActive(href)
    ? 'text-white font-semibold border-b-2 border-white pb-0.5'
    : 'text-blue-300 hover:text-white';
}
function dropdownParentClass(hrefs: string[]): string {
  return hrefs.some(h => isActive(h))
    ? 'text-white font-semibold'
    : 'text-blue-300 hover:text-white';
}
function dropdownItemClass(href: string): string {
  return isActive(href)
    ? 'block px-3 py-1.5 text-white bg-blue-700 font-semibold'
    : 'block px-3 py-1.5 text-blue-100 hover:bg-blue-700 hover:text-white';
}

const storiesHrefs = ['/stories/', '/departments/'];
const budgetsHrefs = ['/operating/', '/capital/', '/changes/', '/cross-year/'];
const exploreHrefs = ['/compare/', '/explorer/', '/dashboard/', '/personnel/', '/embed/', '/glossary/'];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={resolvedOgTitle} />
    <meta property="og:description" content={resolvedOgDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%231e3a5f'/><text x='16' y='23' font-size='20' font-family='system-ui' font-weight='bold' fill='white' text-anchor='middle'>P</text></svg>" />
    <title>{title} | Pittsburgh Budget Explorer</title>
  </head>
  <body class="min-h-screen bg-gray-50 text-gray-900">
    <div id="mobile-banner" class="hidden bg-amber-50 border-b border-amber-200 px-4 py-3 text-sm text-amber-800 md:hidden">
      <div class="flex items-center justify-between max-w-6xl mx-auto">
        <span>This site is optimized for desktop. Tables and charts may be hard to read on smaller screens.</span>
        <button onclick="document.getElementById('mobile-banner').remove();localStorage.setItem('mobile-banner-dismissed','1')" class="ml-3 shrink-0 font-medium text-amber-900 hover:text-amber-700" aria-label="Dismiss">&times;</button>
      </div>
    </div>
    <script is:inline>
      if (window.innerWidth < 768 && !localStorage.getItem('mobile-banner-dismissed')) {
        document.getElementById('mobile-banner').classList.remove('hidden');
      }
    </script>
    <header class="bg-blue-900 text-white px-6 py-3">
      <div class="max-w-6xl mx-auto">
        <div class="flex items-center justify-between">
          <a href="/" class="text-xl font-bold hover:text-blue-200">Pittsburgh Budget Explorer</a>
          <nav class="flex items-center gap-4 text-sm" aria-label="Main navigation">
            <a href="/brief/" class={navClass('/brief/')}>Brief</a>

            <div class="nav-dropdown relative">
              <a href="/stories/" class={`nav-dropdown-trigger ${dropdownParentClass(storiesHrefs)}`} aria-expanded="false" aria-haspopup="true">
                Stories <span class="text-[0.6rem] ml-0.5" aria-hidden="true">&#9662;</span>
              </a>
              <div class="nav-dropdown-menu absolute top-full left-0 pt-2 hidden z-50">
                <div class="bg-blue-800 rounded shadow-lg py-1 min-w-[10rem]">
                  <a href="/stories/" class={dropdownItemClass('/stories/')}>Stories</a>
                  <a href="/departments/" class={dropdownItemClass('/departments/')}>Departments</a>
                </div>
              </div>
            </div>

            <div class="nav-dropdown relative">
              <a href="/operating/" class={`nav-dropdown-trigger ${dropdownParentClass(budgetsHrefs)}`} aria-expanded="false" aria-haspopup="true">
                Budgets <span class="text-[0.6rem] ml-0.5" aria-hidden="true">&#9662;</span>
              </a>
              <div class="nav-dropdown-menu absolute top-full left-0 pt-2 hidden z-50">
                <div class="bg-blue-800 rounded shadow-lg py-1 min-w-[12rem]">
                  <a href="/operating/" class={dropdownItemClass('/operating/')}>Operating</a>
                  <a href="/capital/" class={dropdownItemClass('/capital/')}>Capital</a>
                  <a href="/changes/" class={dropdownItemClass('/changes/')}>What Changed</a>
                  <a href="/cross-year/" class={dropdownItemClass('/cross-year/')}>Proposed vs Adopted</a>
                </div>
              </div>
            </div>

            <div class="nav-dropdown relative">
              <a href="/dashboard/" class={`nav-dropdown-trigger ${dropdownParentClass(exploreHrefs)}`} aria-expanded="false" aria-haspopup="true">
                Explore <span class="text-[0.6rem] ml-0.5" aria-hidden="true">&#9662;</span>
              </a>
              <div class="nav-dropdown-menu absolute top-full left-0 pt-2 hidden z-50">
                <div class="bg-blue-800 rounded shadow-lg py-1 min-w-[10rem]">
                  <a href="/dashboard/" class={dropdownItemClass('/dashboard/')}>Dashboard</a>
                  <a href="/explorer/" class={dropdownItemClass('/explorer/')}>Explorer</a>
                  <a href="/compare/" class={dropdownItemClass('/compare/')}>Compare</a>
                  <a href="/personnel/" class={dropdownItemClass('/personnel/')}>Personnel</a>
                  <a href="/embed/" class={dropdownItemClass('/embed/')}>Embeds</a>
                  <a href="/glossary/" class={dropdownItemClass('/glossary/')}>Glossary</a>
                </div>
              </div>
            </div>
          </nav>
        </div>
      </div>
    </header>
    <main class={fullWidth ? '' : 'max-w-6xl mx-auto px-6 py-8'}>
      <slot />
    </main>
    <script is:inline>
      // Nav dropdown: open on hover/click, close on leave/outside click, keyboard accessible
      document.querySelectorAll('.nav-dropdown').forEach(dd => {
        const trigger = dd.querySelector('.nav-dropdown-trigger');
        const menu = dd.querySelector('.nav-dropdown-menu');
        function open() { menu.classList.remove('hidden'); trigger.setAttribute('aria-expanded', 'true'); }
        function close() { menu.classList.add('hidden'); trigger.setAttribute('aria-expanded', 'false'); }

        dd.addEventListener('mouseenter', open);
        dd.addEventListener('mouseleave', close);

        // Close on outside click
        document.addEventListener('click', (e) => { if (!dd.contains(e.target)) close(); });

        // Keyboard: Escape closes, arrow keys open and navigate items
        dd.addEventListener('keydown', (e) => {
          const items = menu.querySelectorAll('a:not(.nav-dropdown-trigger)');
          const idx = Array.from(items).indexOf(document.activeElement);
          if (e.key === 'Escape') { close(); trigger.focus(); }
          else if (e.key === 'ArrowDown') { e.preventDefault(); open(); items[Math.min(idx + 1, items.length - 1)].focus(); }
          else if (e.key === 'ArrowUp') { e.preventDefault(); items[Math.max(idx - 1, 0)].focus(); }
        });
      });
    </script>
    <footer class="text-center text-sm text-gray-500 py-6 border-t border-gray-200">
      <p>Data extracted from the City of Pittsburgh FY2026 Operating &amp; Capital Budgets</p>
      <p class="mt-1"><a href="/about/" class="hover:text-blue-600 underline">About this site</a> &mdash; how it was built, the role of AI, and important caveats</p>
    </footer>
  </body>
</html>
