---
/**Cross-year comparison: the 2025 proposal vs the 2025 figures reported in the 2026 budget document.*/
import Base from '../layouts/Base.astro';
import SearchBar from '../components/SearchBar.tsx';
import CrossYearPage from '../components/CrossYearPage.tsx';
import { BUDGET_2025, BUDGET_2026 } from '../lib/budget-year';

// "Proposed" comes from the 2025 document; "adopted" is the 2025 column of the 2026 document.
const proposed = BUDGET_2025.views;
const adopted = BUDGET_2026.views;
const proposedChanges = proposed.budgetChanges;
const adoptedChanges = adopted.budgetChanges;
// Budget and FTE for 2025 as each document reports it.
const proposedTotal: number = proposedChanges.totalBudgetCurrent;
const adoptedTotal: number = adoptedChanges.totalBudgetPrior;
const proposedFte: number = proposedChanges.totalFteCurrent;
const adoptedFte: number = adoptedChanges.totalFtePrior;
const budgetDiff = adoptedTotal - proposedTotal;
const fteDiff = Math.round((adoptedFte - proposedFte) * 10) / 10;
---

<Base
  title="Proposed vs Adopted"
  description={`Compare the mayor's proposed ${BUDGET_2025.year} budget to what council adopted — department by department, position by position.`}
  budgetYear={BUDGET_2026}
>
  <h1 class="text-3xl font-bold mb-2">{BUDGET_2025.year}: Proposed vs. Adopted</h1>
  <p class="text-gray-600 mb-4">
    The mayor proposes a budget; council amends and adopts it. This page compares
    the <strong>{BUDGET_2025.year} proposed budget</strong> (from the {BUDGET_2025.year} budget document) to the
    <strong>{BUDGET_2025.year} adopted budget</strong> (as reported in the {BUDGET_2026.year} budget document),
    showing where council made changes.
  </p>

  {/* Aggregate summary */}
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
    <div class="bg-ps-blue-50 rounded-lg border border-ps-blue-200 p-4">
      <div class="text-xs text-ps-blue-600 mb-1">Proposed Budget</div>
      <div class="text-lg font-semibold">${(proposedTotal / 1_000_000).toFixed(1)}M</div>
    </div>
    <div class="bg-ps-blue-50 rounded-lg border border-ps-blue-200 p-4">
      <div class="text-xs text-ps-blue-600 mb-1">Adopted Budget</div>
      <div class="text-lg font-semibold">${(adoptedTotal / 1_000_000).toFixed(1)}M</div>
    </div>
    <div class="bg-ps-blue-50 rounded-lg border border-ps-blue-200 p-4">
      <div class="text-xs text-ps-blue-600 mb-1">Budget Change</div>
      <div class={`text-lg font-semibold ${budgetDiff >= 0 ? 'text-green-600' : 'text-ps-red-600'}`}>
        {budgetDiff >= 0 ? '+' : ''}${(budgetDiff / 1_000_000).toFixed(1)}M
      </div>
    </div>
    <div class="bg-ps-blue-50 rounded-lg border border-ps-blue-200 p-4">
      <div class="text-xs text-ps-blue-600 mb-1"><a href="/glossary/#abbreviations" class="glossary-term" data-tooltip="Full-Time Equivalent — 1.0 = one full-time position. Part-time roles are fractions (e.g., 0.5 = half-time).">FTE</a> Change</div>
      <div class={`text-lg font-semibold ${fteDiff >= 0 ? 'text-green-600' : 'text-ps-red-600'}`}>
        {fteDiff >= 0 ? '+' : ''}{fteDiff} FTE
      </div>
    </div>
  </div>

  <div class="mb-6">
    <SearchBar items={adopted.searchIndex} routePrefix={BUDGET_2026.routePrefix} client:load />
  </div>

  <CrossYearPage
    client:load
    proposedBudgets={proposed.departmentBudgets}
    adoptedBudgets={adopted.departmentBudgets}
    proposedPersonnel={proposed.personnel}
    adoptedPersonnel={adopted.personnel}
    proposedCapital={proposed.capitalProjects}
    adoptedCapital={adopted.capitalProjects}
    routePrefix={BUDGET_2026.routePrefix}
  />
</Base>
