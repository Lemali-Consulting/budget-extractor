---
import Base from '../layouts/Base.astro';
import SearchBar from '../components/SearchBar.tsx';
import budgetData from '../data/budget-data.json';
import capitalData from '../data/capital-budget-data.json';
import searchIndex from '../data/views/search-index.json';

const operatingSections = budgetData.sections;
const capitalSections = capitalData.sections;
const operatingTables = operatingSections.reduce((n: number, s: any) => n + s.tables.length, 0);

// Count capital functional areas
const capitalAreas = new Set(capitalSections.map((s: any) => s.functional_area || 'Other'));

// Helper to parse currency from CIP table cells
function parseCurrency(s: string): number {
  if (!s) return 0;
  return parseFloat(s.replace(/[,$]/g, '')) || 0;
}

// Sum capital 2026 funding
let capitalTotal = 0;
for (const section of capitalSections) {
  for (const table of (section as any).tables || []) {
    if (table.table_type === 'cip_funding') {
      for (const row of table.rows) {
        if (row[0]?.trim().toUpperCase() === 'TOTAL' && row.length > 2) {
          capitalTotal += parseCurrency(row[2]);
        }
      }
    }
  }
}
---

<Base title="Home">
  <h1 class="text-3xl font-bold mb-2">Pittsburgh Budget Explorer</h1>
  <p class="text-gray-600 mb-6">Browse the City of Pittsburgh FY2026 Budget — operating and capital.</p>

  <div class="mb-8">
    <SearchBar items={searchIndex} client:load />
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
    <a href="/operating/" class="block p-6 bg-white rounded-lg border-2 border-blue-200 ring-0 hover:ring-2 hover:ring-blue-400 hover:shadow-lg transition">
      <h2 class="text-2xl font-bold text-blue-900 mb-2">Operating Budget</h2>
      <p class="text-gray-600 mb-3">Department budgets, revenue, trust funds, and financial forecasts for day-to-day city operations.</p>
      <div class="flex gap-4 text-sm text-gray-500">
        <span class="font-medium">{operatingSections.length} sections</span>
        <span>{operatingTables} tables</span>
      </div>
    </a>

    <a href="/capital/" class="block p-6 bg-white rounded-lg border-2 border-green-200 ring-0 hover:ring-2 hover:ring-green-400 hover:shadow-lg transition">
      <h2 class="text-2xl font-bold text-green-900 mb-2">Capital Budget</h2>
      <p class="text-gray-600 mb-3">Six-year capital improvement plan covering infrastructure, facilities, and major projects.</p>
      <div class="flex gap-4 text-sm text-gray-500">
        <span class="font-medium">{capitalSections.length} projects</span>
        <span>{capitalAreas.size} functional areas</span>
        {capitalTotal > 0 && <span>2026: ${(capitalTotal / 1_000_000).toFixed(1)}M</span>}
      </div>
    </a>
  </div>

  <a href="/changes/" class="block p-5 mb-6 bg-amber-50 rounded-lg border-2 border-amber-200 ring-0 hover:ring-2 hover:ring-amber-400 hover:shadow-lg transition">
    <h2 class="text-lg font-bold text-amber-900 mb-1">What Changed in FY2026?</h2>
    <p class="text-sm text-amber-700">The biggest budget increases, decreases, new positions, and eliminated positions — the view you need before a budget hearing.</p>
  </a>

  <div class="grid grid-cols-2 md:grid-cols-5 gap-3">
    <a href="/changes/" class="block p-4 bg-white rounded-lg border ring-0 hover:ring-2 hover:ring-amber-400 hover:shadow transition text-center">
      <div class="font-medium text-gray-700">What Changed</div>
      <div class="text-xs text-gray-400 mt-1">Key budget changes</div>
    </a>
    <a href="/compare/" class="block p-4 bg-white rounded-lg border ring-0 hover:ring-2 hover:ring-blue-400 hover:shadow transition text-center">
      <div class="font-medium text-gray-700">Compare</div>
      <div class="text-xs text-gray-400 mt-1">Departments side by side</div>
    </a>
    <a href="/explorer/" class="block p-4 bg-white rounded-lg border ring-0 hover:ring-2 hover:ring-blue-400 hover:shadow transition text-center">
      <div class="font-medium text-gray-700">Data Explorer</div>
      <div class="text-xs text-gray-400 mt-1">Search all tables</div>
    </a>
    <a href="/charts/" class="block p-4 bg-white rounded-lg border ring-0 hover:ring-2 hover:ring-blue-400 hover:shadow transition text-center">
      <div class="font-medium text-gray-700">Dashboard</div>
      <div class="text-xs text-gray-400 mt-1">Budget at a glance</div>
    </a>
    <a href="/personnel/" class="block p-4 bg-white rounded-lg border ring-0 hover:ring-2 hover:ring-blue-400 hover:shadow transition text-center">
      <div class="font-medium text-gray-700">Personnel</div>
      <div class="text-xs text-gray-400 mt-1">Positions by department</div>
    </a>
  </div>
</Base>
