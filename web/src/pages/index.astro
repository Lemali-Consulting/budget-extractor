---
import Base from '../layouts/Base.astro';
import SearchBar from '../components/SearchBar.tsx';
import BudgetChart from '../components/BudgetChart.tsx';
import FlowSankey from '../components/FlowSankey.tsx';
import type { FlowNode, FlowLink } from '../components/FlowSankey.tsx';
import { revenueColor } from '../lib/flow-colors';
import { colorForSlug } from '../lib/department-groups';
import { HEADLINE, ARCHIVE_YEARS, yearPath } from '../lib/budget-year';
import { operating, sumFor } from '../lib/department-budgets';
import { correctionHref, trustFundCorrections } from '../lib/corrections';

const { columns } = HEADLINE;
const {
  searchIndex,
  departmentBudgets,
  budgetChanges,
  revenueWaterfall,
  capitalFundingSources: capitalFunding,
  personnelByDepartment: personnelByDept,
} = HEADLINE.views;
const operatingSections = HEADLINE.operating.sections;
const capitalSections = HEADLINE.capital.sections;
// The most recent archived budget, linked from the hero.
const [archive] = ARCHIVE_YEARS;
const operatingTables = operatingSections.reduce((n: number, s: any) => n + s.tables.length, 0);

// Count capital functional areas
const capitalAreas = new Set(capitalSections.map((s: any) => s.functional_area || 'Other'));

// Sum capital six-year plan total (current year onward)
const capitalTotal = (capitalFunding as { year: string; amount: number }[])
  .filter(r => parseInt(r.year) >= HEADLINE.year)
  .reduce((s, r) => s + r.amount, 0);

// Summary stats (same logic as dashboard)
const budgetRows = departmentBudgets;
const totalCurrent = sumFor(budgetRows, 'operating', columns.budget);
const totalPrior = sumFor(budgetRows, 'operating', columns.priorBudget);
const trustTotalCurrent = sumFor(budgetRows, 'trust', columns.budget);
const budgetChange = totalPrior > 0 ? ((totalCurrent - totalPrior) / totalPrior * 100) : 0;
// Trust-fund figures in the headline year that rest on one of our corrections to the source PDF.
const trustCorrections = trustFundCorrections({
  corrections: HEADLINE.corrections,
  departmentBudgets: budgetRows,
  budgetColumn: columns.budget,
});
const deptCount = new Set(operating(budgetRows).map(r => r.slug)).size;

const revenueTotal = (revenueWaterfall as { amount: number }[]).reduce((s, r) => s + r.amount, 0);

const capitalCurrent = (capitalFunding as { year: string; amount: number }[])
  .filter(r => r.year === String(HEADLINE.year))
  .reduce((s, r) => s + r.amount, 0);

const personnelData = personnelByDept as { totalFteCurrent: number; totalBudgetCurrent: number }[];
const totalFte = personnelData.reduce((s, r) => s + r.totalFteCurrent, 0);
const totalPersonnelBudget = personnelData.reduce((s, r) => s + r.totalBudgetCurrent, 0);

// Budget changes stats
const changes = budgetChanges as any;
const totalDollarChange = changes.totalBudgetCurrent - changes.totalBudgetPrior;
const totalPct = changes.totalBudgetPrior > 0 ? ((totalDollarChange / changes.totalBudgetPrior) * 100).toFixed(1) : '0';
const fteChange = Math.round(((changes.totalFteCurrent || 0) - (changes.totalFtePrior || 0)) * 10) / 10;
const newPositions = changes.newPositions?.length || 0;
const eliminatedPositions = changes.eliminatedPositions?.length || 0;
const shiftedPositions = changes.shiftedPositions?.length || 0;

function fmtM(n: number): string {
  return `$${(n / 1_000_000).toFixed(1)}M`;
}

// ---------- Teaser Sankey: revenue → trunk → top departments ----------
const teaserDepts = operating(budgetRows)
  .filter((r) => r.year === columns.budget)
  .sort((a, b) => b.amount - a.amount);
const teaserDeptTotal = teaserDepts.reduce((s, d) => s + d.amount, 0);
const TEASER_TOP = 8;
const teaserTop = teaserDepts.slice(0, TEASER_TOP);
const teaserOther = teaserDepts.slice(TEASER_TOP);
const teaserOtherAmount = teaserOther.reduce((s, d) => s + d.amount, 0);
const teaserScale = revenueTotal / teaserDeptTotal;

const teaserNodes: FlowNode[] = [
  ...(revenueWaterfall as { label: string; amount: number }[]).map((r) => ({
    id: `rev:${r.label}`,
    label: r.label.replace(/ Revenue$/, ''),
    category: 'revenue',
    color: revenueColor(r.label),
  })),
  { id: 'trunk', label: 'Operating Budget', category: 'trunk' },
  ...teaserTop.map((d) => ({
    id: `dep:${d.slug}`,
    label: d.department.replace(/^Bureau of |^Department of |^Office of(?: the)? /, ''),
    category: 'department',
    color: colorForSlug(d.slug),
  })),
  ...(teaserOther.length > 0
    ? [{ id: 'dep:other', label: `Other (${teaserOther.length})`, category: 'department-other' }]
    : []),
];

const teaserLinks: FlowLink[] = [
  ...(revenueWaterfall as { label: string; amount: number }[]).map((r) => ({
    source: `rev:${r.label}`,
    target: 'trunk',
    value: r.amount,
  })),
  ...teaserTop.map((d) => ({
    source: 'trunk',
    target: `dep:${d.slug}`,
    value: d.amount * teaserScale,
    color: colorForSlug(d.slug),
  })),
  ...(teaserOther.length > 0
    ? [{ source: 'trunk', target: 'dep:other', value: teaserOtherAmount * teaserScale }]
    : []),
];
---

<Base title="Home">
  <!-- Hero -->
  <div class="mb-8">
    <h1 class="text-3xl font-bold mb-2">Pittsburgh Budget Explorer</h1>
    <p class="text-lg text-gray-600 mb-3">
      The city's 600-page budget PDF, turned into searchable tables and charts.
      <a href="/about/" class="text-blue-600 hover:underline text-base">How this was built</a>
    </p>
    <p class="text-sm text-gray-500 mb-3">
      Showing the <strong>{HEADLINE.label}</strong> budget &mdash; the Mayor's proposal for fiscal year {HEADLINE.year}.
    </p>

    <!-- Example questions -->
    <div class="flex flex-wrap gap-2 text-sm">
      <span class="text-gray-400">Try:</span>
      <a href="/sections/bureau-of-police/" class="inline-flex items-center min-h-[40px] px-3 py-2 bg-blue-50 text-blue-700 rounded-full hover:bg-blue-100 transition">How much does policing cost?</a>
      <a href="/changes/#positions" class="inline-flex items-center min-h-[40px] px-3 py-2 bg-amber-50 text-amber-700 rounded-full hover:bg-amber-100 transition">What new positions were added?</a>
      <a href="/dashboard/" class="inline-flex items-center min-h-[40px] px-3 py-2 bg-green-50 text-green-700 rounded-full hover:bg-green-100 transition">Where does the money come from?</a>
    </div>
  </div>

  <!-- Archive pointer: the previous budget stays browsable -->
  <a
    href={yearPath({ budgetYear: archive, path: '/operating/' })}
    class="block mb-8 p-4 bg-slate-50 rounded-lg border border-slate-300 ring-0 hover:ring-2 hover:ring-slate-400 transition"
  >
    <div class="flex items-baseline justify-between gap-3">
      <h2 class="text-base font-semibold text-slate-800">Looking for the {archive.year} budget?</h2>
      <span class="text-sm text-slate-600 whitespace-nowrap">Browse the {archive.year} archive &rarr;</span>
    </div>
    <p class="text-sm text-slate-600 mt-1">
      The {archive.label} operating budget and the {archive.year} capital budget stay available, with every department, table and source page.
    </p>
  </a>

  <!-- Summary stats -->
  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 mb-8">
    <div class="bg-white rounded-lg border p-4">
      <div class="text-xs text-gray-400 uppercase tracking-wide">Operating Budget</div>
      <div class="text-2xl font-bold text-blue-900 mt-1">{fmtM(totalCurrent)}</div>
      <div class={`text-sm mt-0.5 ${budgetChange >= 0 ? 'text-green-600' : 'text-red-600'}`}>
        {budgetChange >= 0 ? '+' : ''}{budgetChange.toFixed(1)}% vs {HEADLINE.priorYear}
      </div>
    </div>
    <div class="bg-white rounded-lg border p-4">
      <div class="text-xs text-gray-400 uppercase tracking-wide">Trust Funds{trustCorrections.length > 0 && <span aria-hidden="true"> &dagger;</span>}</div>
      <div class="text-2xl font-bold text-slate-700 mt-1">{fmtM(trustTotalCurrent)}</div>
      <div class="text-sm text-gray-500 mt-0.5">Separate from operating</div>
      {trustCorrections.length > 0 && (
        <a
          href={correctionHref({ year: HEADLINE.year, id: trustCorrections[0].id })}
          class="block text-xs text-amber-800 underline hover:text-amber-600 mt-1"
          data-testid="trust-fund-correction-footnote"
        >
          &dagger; Includes a heading correction by us ({trustCorrections.map((c) => c.section).join(', ')}): the PDF mislabels its years. Details
        </a>
      )}
    </div>
    <div class="bg-white rounded-lg border p-4">
      <div class="text-xs text-gray-400 uppercase tracking-wide">Projected Revenue</div>
      <div class="text-2xl font-bold text-green-900 mt-1">{fmtM(revenueTotal)}</div>
      <div class="text-sm text-gray-500 mt-0.5">{(revenueWaterfall as any[]).length} sources</div>
    </div>
    <div class="bg-white rounded-lg border p-4">
      <div class="text-xs text-gray-400 uppercase tracking-wide">Capital ({HEADLINE.year})</div>
      <div class="text-2xl font-bold text-amber-900 mt-1">{fmtM(capitalCurrent)}</div>
      <div class="text-sm text-gray-500 mt-0.5">6-yr plan: {fmtM(capitalTotal)}</div>
    </div>
    <div class="bg-white rounded-lg border p-4">
      <div class="text-xs text-gray-400 uppercase tracking-wide">Personnel</div>
      <div class="text-2xl font-bold text-purple-900 mt-1">{totalFte.toLocaleString('en-US')} FTE</div>
      <div class="text-sm text-gray-500 mt-0.5">{fmtM(totalPersonnelBudget)} payroll</div>
    </div>
  </div>

  <!-- Money Flow teaser -->
  <a
    href="/flow/"
    class="block mb-8 p-5 bg-white rounded-lg border-2 border-blue-200 ring-0 hover:ring-2 hover:ring-blue-400 hover:shadow-lg transition"
  >
    <div class="flex items-baseline justify-between mb-2">
      <h2 class="text-xl font-bold text-blue-900">Where the Money Flows</h2>
      <span class="text-sm text-blue-600 hover:text-blue-800">See the full money flow &rarr;</span>
    </div>
    <p class="text-sm text-gray-600 mb-3">
      From {(revenueWaterfall as any[]).length} revenue sources, through the operating budget, out to {teaserDepts.length} departments.
    </p>
    <FlowSankey nodes={teaserNodes} links={teaserLinks} width={1000} height={280} showLabels />
  </a>

  <!-- Trends teaser -->
  <a
    href="/trends/"
    class="block mb-8 p-5 bg-white rounded-lg border-2 border-blue-200 ring-0 hover:ring-2 hover:ring-blue-400 hover:shadow-lg transition"
  >
    <div class="flex items-baseline justify-between mb-2">
      <h2 class="text-xl font-bold text-blue-900">Budget Trends Over Time</h2>
      <span class="text-sm text-blue-600 hover:text-blue-800">See the trends &rarr;</span>
    </div>
    <p class="text-sm text-gray-600">
      Revenue, spending and reserves across budget years, with the {HEADLINE.label} budget set against that history.
    </p>
  </a>

  <!-- What Changed — prominent callout -->
  <a href="/changes/" class="block mb-8 p-6 bg-amber-50 rounded-lg border-2 border-amber-200 ring-0 hover:ring-2 hover:ring-amber-400 hover:shadow-lg transition">
    <h2 class="text-xl font-bold text-amber-900 mb-2">What Changed in {HEADLINE.fiscalLabel}?</h2>
    <p class="text-sm text-amber-800 mb-3">The biggest budget increases, decreases, new positions, and eliminated positions — the view you need before a budget hearing.</p>
    <div class="flex flex-wrap gap-4 text-sm">
      <span class="font-semibold text-amber-900">{totalDollarChange > 0 ? '+' : ''}{fmtM(totalDollarChange)} ({totalPct}%)</span>
      <span class="text-amber-700">{newPositions} new positions</span>
      <span class="text-amber-700">{eliminatedPositions} eliminated</span>
      {shiftedPositions > 0 && <span class="text-amber-700">{shiftedPositions} shifted</span>}
      {fteChange !== 0 && <span class="text-amber-700">Net {fteChange > 0 ? '+' : ''}{fteChange} FTE</span>}
    </div>
  </a>

  <!-- Operating & Capital cards -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
    <a href="/operating/" class="block p-6 bg-white rounded-lg border-2 border-blue-200 ring-0 hover:ring-2 hover:ring-blue-400 hover:shadow-lg transition">
      <h2 class="text-2xl font-bold text-blue-900 mb-2">Operating Budget</h2>
      <p class="text-gray-600 mb-3">Department budgets, revenue, trust funds, and financial forecasts for day-to-day city operations.</p>
      <div class="flex gap-4 text-sm text-gray-500">
        <span class="font-medium">{operatingSections.length} sections</span>
        <span>{operatingTables} tables</span>
      </div>
    </a>

    <a href="/capital/" class="block p-6 bg-white rounded-lg border-2 border-green-200 ring-0 hover:ring-2 hover:ring-green-400 hover:shadow-lg transition">
      <h2 class="text-2xl font-bold text-green-900 mb-2">Capital Budget</h2>
      <p class="text-gray-600 mb-3">Six-year capital improvement plan covering infrastructure, facilities, and major projects.</p>
      <div class="flex gap-4 text-sm text-gray-500">
        <span class="font-medium">{capitalSections.length} projects</span>
        <span>{capitalAreas.size} functional areas</span>
        {capitalCurrent > 0 && <span>{HEADLINE.year}: {fmtM(capitalCurrent)}</span>}
      </div>
    </a>
  </div>

  <!-- Inline chart: top departments -->
  <div class="bg-white rounded-lg border p-5 mb-8">
    <div class="flex items-baseline justify-between mb-1">
      <h2 class="text-lg font-semibold">Top Departments by Budget</h2>
      <a href="/dashboard/" class="text-sm text-blue-500 hover:text-blue-700">Full dashboard &rarr;</a>
    </div>
    <p class="text-sm text-gray-500 mb-3">{HEADLINE.fiscalLabel} operating budget — largest {deptCount > 15 ? 15 : deptCount} of {deptCount} departments.</p>
    <BudgetChart data={operating(budgetRows)} client:load />
  </div>

  <!-- Search -->
  <div class="mb-8">
    <h2 class="text-lg font-semibold mb-2">Search</h2>
    <SearchBar items={searchIndex} client:load />
  </div>

  <!-- Quick links -->
  <div class="grid grid-cols-2 md:grid-cols-5 gap-3">
    <a href="/changes/" class="block p-4 bg-white rounded-lg border ring-0 hover:ring-2 hover:ring-amber-400 hover:shadow transition text-center">
      <div class="font-medium text-gray-700">What Changed</div>
      <div class="text-xs text-gray-400 mt-1">Key budget changes</div>
    </a>
    <a href="/compare/" class="block p-4 bg-white rounded-lg border ring-0 hover:ring-2 hover:ring-blue-400 hover:shadow transition text-center">
      <div class="font-medium text-gray-700">Compare</div>
      <div class="text-xs text-gray-400 mt-1">Departments side by side</div>
    </a>
    <a href="/explorer/" class="block p-4 bg-white rounded-lg border ring-0 hover:ring-2 hover:ring-blue-400 hover:shadow transition text-center">
      <div class="font-medium text-gray-700">Data Explorer</div>
      <div class="text-xs text-gray-400 mt-1">Search all tables</div>
    </a>
    <a href="/dashboard/" class="block p-4 bg-white rounded-lg border ring-0 hover:ring-2 hover:ring-blue-400 hover:shadow transition text-center">
      <div class="font-medium text-gray-700">Dashboard</div>
      <div class="text-xs text-gray-400 mt-1">Budget at a glance</div>
    </a>
    <a href="/personnel/" class="block p-4 bg-white rounded-lg border ring-0 hover:ring-2 hover:ring-blue-400 hover:shadow transition text-center">
      <div class="font-medium text-gray-700">Personnel</div>
      <div class="text-xs text-gray-400 mt-1">Positions by department</div>
    </a>
  </div>
</Base>
