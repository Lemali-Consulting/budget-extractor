---
import Base from '../layouts/Base.astro';
import SiteSearch from '../components/SiteSearch.tsx';
import SummaryCards from '../components/home/SummaryCards.astro';
import MoneyFlowTeaser from '../components/home/MoneyFlowTeaser.astro';
import TopDepartments from '../components/home/TopDepartments.astro';
import { SITE_NAME } from '../lib/site.mjs';
import { HEADLINE, ARCHIVE_YEARS, yearPath, type BudgetYear } from '../lib/budget-year';
import { capitalYearTotal, fmtM } from '../lib/headline-figures';

const operatingSections = HEADLINE.operating.sections;
const capitalSections = HEADLINE.capital.sections;
// The most recent archived budget, linked from the hero (none while only 2027 is published).
const [archive] = ARCHIVE_YEARS as (BudgetYear | undefined)[];
const operatingTables = operatingSections.reduce((n: number, s: any) => n + s.tables.length, 0);

// Count capital functional areas
const capitalAreas = new Set(capitalSections.map((s: any) => s.functional_area || 'Other'));
const capitalCurrent = capitalYearTotal;
---

<Base title={SITE_NAME} description={`The City of Pittsburgh's ${HEADLINE.documentsName}, turned into searchable tables and charts.`}>
  <!-- Hero -->
  <div class="mb-8">
    <h1 class="text-3xl font-bold mb-2">Pittsburgh Budget Explorer</h1>
    <p class="text-lg text-gray-600 mb-3">
      The city's 600-page budget PDF, turned into searchable tables and charts.
      <a href="/about/" class="text-ps-blue-600 hover:underline text-base">How this was built</a>
    </p>
    <p class="text-sm text-gray-500 mb-3">
      Showing the mayor's <strong>{HEADLINE.budgetName.toLowerCase()}</strong>.
    </p>

    <!-- Example questions -->
    <div class="flex flex-wrap gap-2 text-sm">
      <span class="text-gray-400">Try:</span>
      <a href="/departments/bureau-of-police/" class="inline-flex items-center min-h-[40px] px-3 py-2 bg-ps-blue-50 text-ps-blue-700 rounded-full hover:bg-ps-blue-100 transition">How much does policing cost?</a>
      <a href="/flow/" class="inline-flex items-center min-h-[40px] px-3 py-2 bg-green-50 text-green-700 rounded-full hover:bg-green-100 transition">Where does the money come from?</a>
    </div>
  </div>

  <!-- Archive pointer, shown while a previous budget is published -->
  {archive && (
    <a
      href={yearPath({ budgetYear: archive, path: '/operating/' })}
      class="block mb-8 p-4 bg-slate-50 rounded-lg border border-slate-300 ring-0 hover:ring-2 hover:ring-slate-400 transition"
    >
      <div class="flex items-baseline justify-between gap-3">
        <h2 class="text-base font-semibold text-slate-800">Looking for the {archive.year} budget?</h2>
        <span class="text-sm text-slate-600 whitespace-nowrap">Browse the {archive.year} archive &rarr;</span>
      </div>
      <p class="text-sm text-slate-600 mt-1">
        The {archive.label} operating budget and the {archive.year} capital budget stay available, with every department, table and source page.
      </p>
    </a>
  )}

  <SummaryCards class="mb-8" />

  <MoneyFlowTeaser class="mb-8" />

  <!-- Trends teaser -->
  <a
    href="/trends/"
    class="block mb-8 p-5 bg-white rounded-lg border-2 border-ps-blue-200 ring-0 hover:ring-2 hover:ring-ps-blue-400 hover:shadow-lg transition"
  >
    <div class="flex items-baseline justify-between mb-2">
      <h2 class="text-xl font-bold text-ps-blue-900">Budget trends over time</h2>
      <span class="text-sm text-ps-blue-600 hover:text-ps-blue-800">See the trends &rarr;</span>
    </div>
    <p class="text-sm text-gray-600">
      Revenue, spending and reserves across budget years, with the {HEADLINE.budgetName.toLowerCase()} set against that history.
    </p>
  </a>

  <!-- Operating & Capital cards -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
    <a href="/operating/" class="block p-6 bg-white rounded-lg border-2 border-ps-blue-200 ring-0 hover:ring-2 hover:ring-ps-blue-400 hover:shadow-lg transition">
      <h2 class="text-2xl font-bold text-ps-blue-900 mb-2">Operating budget</h2>
      <p class="text-gray-600 mb-3">Department budgets, revenue, trust funds and financial forecasts for day-to-day city operations.</p>
      <div class="flex gap-4 text-sm text-gray-500">
        <span class="font-medium">{operatingSections.length} sections</span>
        <span>{operatingTables} tables</span>
      </div>
    </a>

    <a href="/capital/" class="block p-6 bg-white rounded-lg border-2 border-green-200 ring-0 hover:ring-2 hover:ring-green-400 hover:shadow-lg transition">
      <h2 class="text-2xl font-bold text-green-900 mb-2">Capital budget</h2>
      <p class="text-gray-600 mb-3">Six-year capital improvement plan covering infrastructure, facilities and major projects.</p>
      <div class="flex gap-4 text-sm text-gray-500">
        <span class="font-medium">{capitalSections.length} projects</span>
        <span>{capitalAreas.size} functional areas</span>
        {capitalCurrent > 0 && <span>{HEADLINE.year}: {fmtM(capitalCurrent)}</span>}
      </div>
    </a>
  </div>

  <TopDepartments class="mb-8" />

  <!-- Search -->
  <div class="mb-8">
    <h2 class="text-lg font-semibold mb-2">Search</h2>
    <SiteSearch client:load />
  </div>

  <!-- Quick links -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
    <a href="/compare/" class="block p-4 bg-white rounded-lg border ring-0 hover:ring-2 hover:ring-ps-blue-400 hover:shadow transition text-center">
      <div class="font-medium text-gray-700">Compare</div>
      <div class="text-xs text-gray-400 mt-1">Departments side by side</div>
    </a>
    <a href="/flow/" class="block p-4 bg-white rounded-lg border ring-0 hover:ring-2 hover:ring-ps-blue-400 hover:shadow transition text-center">
      <div class="font-medium text-gray-700">Money flow</div>
      <div class="text-xs text-gray-400 mt-1">Revenue to spending</div>
    </a>
    <a href="/personnel/" class="block p-4 bg-white rounded-lg border ring-0 hover:ring-2 hover:ring-ps-blue-400 hover:shadow transition text-center">
      <div class="font-medium text-gray-700">Personnel</div>
      <div class="text-xs text-gray-400 mt-1">Positions by department</div>
    </a>
  </div>
</Base>
