---
import Base from '../layouts/Base.astro';
import PersonnelExplorer from '../components/PersonnelExplorer.tsx';
import PersonnelTreemap from '../components/PersonnelTreemap.tsx';
import personnelData from '../data/views/personnel.json';
import personnelByDept from '../data/views/personnel-by-department.json';
import budgetChanges from '../data/views/budget-changes.json';

const data = budgetChanges as any;
const fteChange = (data.totalFte2026 || 0) - (data.totalFte2025 || 0);
const newCount = data.newPositions?.length || 0;
const elimCount = data.eliminatedPositions?.length || 0;

// Top new positions by budget
const topNew = [...(data.newPositions || [])].sort((a: any, b: any) => b.budget - a.budget).slice(0, 5);
const topElim = [...(data.eliminatedPositions || [])].sort((a: any, b: any) => b.budget - a.budget).slice(0, 5);

function fmtDollar(n: number): string {
  if (n >= 1_000_000) return `$${(n / 1_000_000).toFixed(1)}M`;
  if (n >= 1_000) return `$${(n / 1_000).toFixed(0)}K`;
  return `$${n.toFixed(0)}`;
}
---

<Base title="Personnel">
  <nav class="text-sm text-gray-500 mb-4">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span class="mx-1" aria-hidden="true">/</span>
    <span>Personnel</span>
  </nav>

  <h1 class="text-3xl font-bold mb-2">Personnel Explorer</h1>
  <p class="text-gray-600 mb-6">Search and filter positions across all departments.</p>

  {/* Staffing changes summary */}
  <div class="bg-white rounded-lg border p-4 mb-6">
    <h2 class="text-lg font-semibold mb-3">Staffing Changes: 2025 &rarr; 2026</h2>
    <div class="grid grid-cols-3 gap-4 mb-4">
      <div class="bg-gray-50 rounded-lg p-3">
        <div class="text-xs text-gray-500 mb-1">Net <a href="/glossary/#abbreviations" class="glossary-term" data-tooltip="Full-Time Equivalent — 1.0 = one full-time position. Part-time roles are fractions (e.g., 0.5 = half-time).">FTE</a> Change</div>
        <div class={`text-lg font-semibold ${fteChange >= 0 ? 'text-green-600' : 'text-red-600'}`}>
          {fteChange >= 0 ? '+' : ''}{Math.round(fteChange)}
        </div>
      </div>
      <div class="bg-gray-50 rounded-lg p-3">
        <div class="text-xs text-gray-500 mb-1">New Positions</div>
        <div class="text-lg font-semibold text-green-600">+{newCount}</div>
      </div>
      <div class="bg-gray-50 rounded-lg p-3">
        <div class="text-xs text-gray-500 mb-1">Eliminated Positions</div>
        <div class="text-lg font-semibold text-red-600">-{elimCount}</div>
      </div>
    </div>

    <div class="grid md:grid-cols-2 gap-4">
      {topNew.length > 0 && (
        <div>
          <h3 class="text-sm font-semibold text-green-700 mb-2">Top New Positions</h3>
          <ul class="text-sm space-y-1">
            {topNew.map((p: any) => (
              <li class="flex justify-between">
                <span class="truncate mr-2" title={`${p.title} — ${p.department}`}>{p.title} <span class="text-gray-400">({p.department})</span></span>
                <span class="font-mono text-green-600 whitespace-nowrap">{p.fte} FTE · {fmtDollar(p.budget)}</span>
              </li>
            ))}
          </ul>
        </div>
      )}
      {topElim.length > 0 && (
        <div>
          <h3 class="text-sm font-semibold text-red-700 mb-2">Top Eliminated Positions</h3>
          <ul class="text-sm space-y-1">
            {topElim.map((p: any) => (
              <li class="flex justify-between">
                <span class="truncate mr-2" title={`${p.title} — ${p.department}`}>{p.title} <span class="text-gray-400">({p.department})</span></span>
                <span class="font-mono text-red-600 whitespace-nowrap">{p.fte} FTE · {fmtDollar(p.budget)}</span>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>

    <div class="flex gap-4 mt-4 text-sm">
      <a href="/changes/" class="text-blue-600 hover:underline">All new &amp; eliminated positions &rarr;</a>
      <a href="/cross-year/#personnel" class="text-blue-600 hover:underline">Proposed vs. adopted staffing &rarr;</a>
    </div>
  </div>

  <PersonnelTreemap data={personnelByDept} client:load />

  <PersonnelExplorer rows={personnelData} client:load />
</Base>
