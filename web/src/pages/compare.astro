---
import Base from '../layouts/Base.astro';
import SiteSearch from '../components/SiteSearch.tsx';
import DepartmentCompare from '../components/DepartmentCompare.tsx';
import { HEADLINE } from '../lib/budget-year';
import { operating } from '../lib/department-budgets';
import { publishedSectionHrefs } from '../lib/published-pages';

const { departmentBudgets, personnelByDepartment } = HEADLINE.views;
const operatingBudgets = operating(departmentBudgets);
---

<Base title="Compare departments" description="Compare budgets, staffing, and trends across Pittsburgh city departments side by side.">
  <h1 class="text-3xl font-bold mb-2">Compare departments</h1>
  <p class="text-gray-600 mb-4">Select 2-4 departments to compare budgets, staffing, and year-over-year changes side by side.</p>

  <div class="mb-6">
    <SiteSearch client:load />
  </div>

  <DepartmentCompare
    client:load
    budgets={operatingBudgets}
    personnel={personnelByDepartment}
    year={HEADLINE.year}
    priorYear={HEADLINE.priorYear}
    sectionHrefs={publishedSectionHrefs(HEADLINE)}
  />
</Base>
