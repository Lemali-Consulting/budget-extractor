---
/**Department directory — index of all department one-pagers.*/
import Base from '../../layouts/Base.astro';
import departmentBudgets from '../../data/views/department-budgets.json';
import budgetChanges from '../../data/views/budget-changes.json';
import personnelByDept from '../../data/views/personnel-by-department.json';

const changes = budgetChanges as any;
const budgets = departmentBudgets as { department: string; slug: string; year: string; amount: number }[];
const personnel = personnelByDept as any[];

// Build a lookup of department data
const deptMap = new Map<string, any>();
for (const dc of changes.departmentChanges) {
  deptMap.set(dc.slug, dc);
}

// Get 2026 budgets sorted by amount
const depts2026 = budgets
  .filter(r => r.year === '2026 Budget')
  .sort((a, b) => b.amount - a.amount);

function fmtM(n: number): string {
  return `$${(n / 1_000_000).toFixed(1)}M`;
}
---

<Base title="Departments" description="Simplified one-page summaries for every Pittsburgh city department.">
  <h1 class="text-3xl font-bold mb-2">Department Summaries</h1>
  <p class="text-gray-600 mb-6">One-page overviews of every city department — budget, staffing, and what changed. Designed for quick reference and easy printing.</p>

  <div class="grid gap-3">
    {depts2026.map((dept) => {
      const dc = deptMap.get(dept.slug);
      const pers = personnel.find((p: any) => p.slug === dept.slug);
      const change = dc?.dollarChange || 0;
      const changePct = dc?.pctChange || 0;
      const fte = pers?.totalFte2026 || dc?.fte2026;

      return (
        <a href={`/departments/${dept.slug}/`} class="block bg-white rounded-lg border p-4 hover:border-blue-300 hover:shadow-sm transition-all">
          <div class="flex items-center justify-between">
            <div>
              <h2 class="font-semibold text-blue-900">{dept.department}</h2>
              <div class="text-sm text-gray-500 mt-0.5">
                {fmtM(dept.amount)} budget
                {fte ? ` · ${Math.round(fte)} FTE` : ''}
              </div>
            </div>
            <div class="text-right">
              <div class={`text-sm font-medium tabular-nums ${change >= 0 ? 'text-green-600' : 'text-red-600'}`}>
                {change >= 0 ? '+' : ''}{changePct}%
              </div>
              <div class="text-xs text-gray-400">vs 2025</div>
            </div>
          </div>
        </a>
      );
    })}
  </div>
</Base>
