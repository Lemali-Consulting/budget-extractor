---
/**Headline department page: the department's summary above its full PDF section.*/
import SectionPage from '../../components/pages/SectionPage.astro';
import { HEADLINE } from '../../lib/budget-year';
import { departmentSectionStaticPaths } from '../../lib/static-paths';

export function getStaticPaths() {
  return departmentSectionStaticPaths(HEADLINE);
}

const { section, prev, next } = Astro.props;
---

<SectionPage budgetYear={HEADLINE} section={section} prev={prev} next={next} />
