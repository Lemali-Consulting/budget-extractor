---
/**Headline department one-pager; the body is shared with the archive route.*/
import DepartmentPage from '../../components/pages/DepartmentPage.astro';
import { HEADLINE } from '../../lib/budget-year';
import { departmentStaticPaths } from '../../lib/static-paths';

export function getStaticPaths() {
  return departmentStaticPaths(HEADLINE);
}

const { slug } = Astro.params;
---

<DepartmentPage budgetYear={HEADLINE} slug={slug!} />
