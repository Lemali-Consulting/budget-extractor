---
/**Headline capital project page; the body is shared with the archive route.*/
import CapitalProjectPage from '../../components/pages/CapitalProjectPage.astro';
import { HEADLINE } from '../../lib/budget-year';
import { capitalStaticPaths } from '../../lib/static-paths';

export function getStaticPaths() {
  return capitalStaticPaths(HEADLINE);
}

const { section, prev, next } = Astro.props;
---

<CapitalProjectPage budgetYear={HEADLINE} section={section} prev={prev} next={next} />
