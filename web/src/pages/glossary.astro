---
import Base from '../layouts/Base.astro';
import budgetData from '../data/budget-data.json';
import backlinksData from '../data/views/glossary-backlinks.json';

const glossary = budgetData.glossary;
const backlinks: Record<string, { sections: { slug: string; title: string; budgetType: string }[]; total: number }> = backlinksData;

function sectionUrl(s: { slug: string; budgetType: string }): string {
  return s.budgetType === 'capital' ? `/capital/${s.slug}` : `/sections/${s.slug}`;
}

const sections = [
  { key: 'abbreviations', title: 'Abbreviations' },
  { key: 'general_terms', title: 'General Terms' },
  { key: 'fiscal_metrics', title: 'Fiscal Metrics' },
  { key: 'capital_funding_sources', title: 'Capital Funding Sources' },
  { key: 'funds', title: 'Funds' },
  { key: 'revenue_subclasses', title: 'Revenue Subclasses' },
  { key: 'expenditure_subclasses', title: 'Expenditure Subclasses' },
  { key: 'revenue_line_items', title: 'Revenue Line Items' },
  { key: 'expenditure_line_items', title: 'Expenditure Line Items' },
  { key: 'departments', title: 'Departments' },
  { key: 'budget_structure', title: 'Budget Structure' },
];

/* Normalize all glossary sections into a uniform shape:
   { term: string, description: string, code?: string, backlinkKey?: string } */
type GlossaryEntry = { term: string; description: string; code?: string; backlinkKey?: string };

function normalizeSection(key: string): GlossaryEntry[] {
  const data = (glossary as any)[key];
  if (!data) return [];

  switch (key) {
    case 'abbreviations':
      return Object.entries(data).sort().map(([abbr, meaning]) => ({
        term: abbr,
        description: meaning as string,
        code: abbr,
        backlinkKey: abbr,
      }));

    case 'capital_funding_sources':
      return data.map((item: any) => ({
        term: item.source,
        description: item.description,
        code: item.source,
        backlinkKey: item.source,
      }));

    case 'funds':
      return data.map((item: any) => ({
        term: item.name,
        description: item.description,
        backlinkKey: item.name,
      }));

    case 'revenue_subclasses':
    case 'expenditure_subclasses':
      return data.map((item: any) => ({
        term: item.name,
        description: '',
        code: `Code ${item.code}`,
      }));

    case 'departments':
      return data.map((item: any) => ({
        term: item.name,
        description: '',
        code: item.cost_center,
      }));

    case 'budget_structure': {
      const entries: GlossaryEntry[] = [];
      if (data.fiscal_year_columns) {
        for (const item of data.fiscal_year_columns) {
          entries.push({ term: item.label, description: item.description });
        }
      }
      if (data.table_types) {
        for (const item of data.table_types) {
          entries.push({ term: item.name, description: item.description });
        }
      }
      return entries;
    }

    default:
      // general_terms, fiscal_metrics, revenue_line_items, expenditure_line_items
      return data.map((item: any) => ({
        term: item.term,
        description: item.description,
      }));
  }
}
---

<Base title="Glossary">
  <nav class="text-sm text-gray-500 mb-4">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span class="mx-1" aria-hidden="true">/</span>
    <span>Glossary</span>
  </nav>

  <h1 class="text-3xl font-bold mb-2">Budget Glossary</h1>
  <p class="text-gray-600 mb-6">Terms, codes, abbreviations, and structure from the City of Pittsburgh FY2026 Operating and Capital Budgets.</p>

  <nav class="mb-8 border rounded-lg bg-white p-4">
    <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-2">On this page</h2>
    <ul class="columns-2 md:columns-3 gap-x-6 text-sm">
      {sections.map((s) => (
        <li class="py-0.5">
          <a href={`#${s.key}`} class="text-blue-600 hover:text-blue-800 hover:underline">{s.title}</a>
        </li>
      ))}
    </ul>
  </nav>

  {sections.map((s) => {
    const entries = normalizeSection(s.key);
    if (!entries.length) return null;
    return (
      <section id={s.key} class="mb-10">
        <h2 class="text-xl font-semibold mb-3 border-b pb-1">{s.title}</h2>
        <dl class="bg-white rounded-lg border divide-y">
          {entries.map((entry) => {
            const bl = entry.backlinkKey ? backlinks[entry.backlinkKey] : undefined;
            return (
              <div class="px-4 py-3">
                <dt class="font-medium">
                  {entry.code && (
                    <span class="inline-block font-mono text-xs bg-gray-100 text-gray-600 px-1.5 py-0.5 rounded mr-2">{entry.code}</span>
                  )}
                  {entry.term}
                </dt>
                {entry.description && (
                  <dd class="text-sm text-gray-600 mt-1">{entry.description}</dd>
                )}
                {bl && (
                  <dd class="flex flex-wrap gap-1 mt-2">
                    <span class="text-xs text-gray-400 mr-1">Used in:</span>
                    {bl.sections.slice(0, 5).map((sec) => (
                      <a href={sectionUrl(sec)} class="inline-block text-xs px-2 py-0.5 bg-blue-50 text-blue-700 rounded hover:bg-blue-100 whitespace-nowrap">{sec.title}</a>
                    ))}
                    {bl.total > 5 && (
                      <span class="text-xs text-gray-400">+{bl.total - 5} more</span>
                    )}
                  </dd>
                )}
              </div>
            );
          })}
        </dl>
      </section>
    );
  })}
</Base>
