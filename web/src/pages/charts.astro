---
import Base from '../layouts/Base.astro';
import BudgetChart from '../components/BudgetChart.tsx';
import WaterfallChart from '../components/WaterfallChart.tsx';
import departmentBudgets from '../data/views/department-budgets.json';
import revenueWaterfall from '../data/views/revenue-waterfall.json';
---

<Base title="Budget Charts">
  <nav class="text-sm text-gray-500 mb-4">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span class="mx-1">/</span>
    <span>Charts</span>
  </nav>

  <h1 class="text-3xl font-bold mb-2">Budget Visualizations</h1>
  <p class="text-gray-600 mb-8">Overview charts for the FY2026 Operating Budget.</p>

  <div class="space-y-12">
    <section>
      <h2 class="text-xl font-semibold mb-4">Department Comparison</h2>
      <p class="text-gray-600 mb-4">Top departments by budget total.</p>
      <BudgetChart data={departmentBudgets} client:load />
    </section>

    <section>
      <WaterfallChart data={revenueWaterfall} client:load />
    </section>
  </div>
</Base>
