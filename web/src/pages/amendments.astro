---
import Base from '../layouts/Base.astro';
import SearchBar from '../components/SearchBar.tsx';
import ChangesChart from '../components/ChangesChart.tsx';
import { BUDGET_2026 } from '../lib/budget-year';

const { amendment } = BUDGET_2026;
if (!amendment) throw new Error(`${BUDGET_2026.year} has no amendment data`);
const prefix = BUDGET_2026.routePrefix;
const searchIndex = BUDGET_2026.views.searchIndex;
const year = BUDGET_2026.year;
const data = amendment.changes;
const meta = amendment.cellDiffs.meta || {};
const adopted = data.totalBudgetAdopted;
const amended = data.totalBudgetAmended;
const netChange = amended - adopted;
const netPct = adopted > 0 ? ((netChange / adopted) * 100).toFixed(1) : '0';
const fteChange = (data.totalFteAmended || 0) - (data.totalFteAdopted || 0);
const label = data.amendmentLabel || amendment.documentLabel;

function fmtM(n: number): string {
  return `$${(n / 1_000_000).toFixed(1)}M`;
}

const categoryStyle: Record<string, string> = {
  Appropriation: 'bg-ps-yellow-50 border-ps-yellow-200 text-ps-yellow-900',
  Legislation: 'bg-ps-blue-50 border-ps-blue-200 text-ps-blue-900',
};

const jump = [
  { id: 'increases', label: 'Increases' },
  { id: 'decreases', label: 'Decreases' },
  { id: 'legislative', label: 'Legislative' },
  { id: 'all-depts', label: 'All Depts' },
];
---

<Base title={`${year} Amendments`} budgetYear={BUDGET_2026} currentHref="/" description={`How City Council's amended ${year} operating budget (${label}) differs from the December adopted budget.`} ogDescription={`The amended ${year} operating budget is ${netChange >= 0 ? 'up' : 'down'} ${netPct}% (${fmtM(Math.abs(netChange))}) from the adopted budget.`}>
  <h1 class="text-3xl font-bold mb-2">{year} Budget Amendments</h1>
  <p class="text-gray-600 mb-4">
    The City published an amended {year} operating budget (<strong>{label}</strong>), revising the
    version adopted in December. This page compares it line-by-line against the adopted budget.
    Amended figures are used throughout the <a href={`${prefix}/operating/`} class="text-ps-blue-600 hover:underline">{year} archive</a>; changed cells are highlighted on each
    department's tables.
  </p>

  <div class="mb-6">
    <SearchBar items={searchIndex} routePrefix={prefix} client:load />
  </div>

  <div class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-4">
    <div class="bg-white rounded-lg border p-4">
      <div class="text-xs text-gray-500 mb-1">{amendment.adoptedLabel.replace(/[()]/g, '')}</div>
      <div class="text-lg font-semibold">{fmtM(adopted)}</div>
    </div>
    <div class="bg-white rounded-lg border p-4">
      <div class="text-xs text-gray-500 mb-1">{amendment.amendedLabel.replace(/[()]/g, '')}</div>
      <div class="text-lg font-semibold">{fmtM(amended)}</div>
    </div>
    <div class="bg-white rounded-lg border p-4">
      <div class="text-xs text-gray-500 mb-1">Net Change</div>
      <div class={`text-lg font-semibold ${netChange >= 0 ? 'text-green-600' : 'text-ps-red-600'}`}>
        {netChange >= 0 ? '+' : ''}{netPct}% ({fmtM(Math.abs(netChange))})
      </div>
    </div>
    <div class="bg-white rounded-lg border p-4">
      <div class="text-xs text-gray-500 mb-1">FTE Change</div>
      <div class={`text-lg font-semibold ${fteChange >= 0 ? 'text-green-600' : 'text-ps-red-600'}`}>
        {fteChange >= 0 ? '+' : ''}{Math.round(fteChange * 10) / 10}
      </div>
    </div>
    <div class="bg-white rounded-lg border p-4">
      <div class="text-xs text-gray-500 mb-1">Changed Line Items</div>
      <div class="text-lg font-semibold">{meta.changedLineItemCount ?? '—'}</div>
    </div>
  </div>

  <!-- Jump nav -->
  <nav class="sticky top-0 z-10 bg-gray-50 border-b border-gray-200 -mx-6 px-6 py-2 mb-6 flex gap-3 overflow-x-auto text-sm" aria-label="Page sections">
    {jump.map(s => (
      <a href={`#${s.id}`} class="text-ps-blue-600 hover:text-ps-blue-800 whitespace-nowrap font-medium">{s.label}</a>
    ))}
  </nav>

  <div id="increases" class="scroll-mt-12">
    <ChangesChart client:load routePrefix={prefix} data={data.topIncreases} title="Largest Amendment Increases" color="#16a34a" />
  </div>

  <div id="decreases" class="scroll-mt-12">
    <ChangesChart client:load routePrefix={prefix} data={data.topDecreases} title="Largest Amendment Decreases" color="#DC2725" />
  </div>

  {data.legislativeChanges?.length > 0 && (
    <div id="legislative" class="mb-8 scroll-mt-12">
      <h2 class="text-2xl font-bold mb-2">Legislative Changes</h2>
      <p class="text-gray-600 mb-4 text-sm">Changes in the authorizing legislation that aren't individual table line items.</p>
      <div class="grid gap-3 md:grid-cols-2">
        {data.legislativeChanges.map((c: any) => (
          <div class={`border rounded-lg p-4 ${categoryStyle[c.category] || 'bg-gray-50 border-gray-200 text-gray-900'}`}>
            <div class="text-xs uppercase tracking-wide opacity-70 mb-1">{c.category}</div>
            <div class="font-semibold">{c.title}</div>
            <div class="text-sm mt-1 opacity-90">{c.detail}</div>
          </div>
        ))}
      </div>
    </div>
  )}

  <div id="all-depts" class="bg-white rounded-lg border p-4 scroll-mt-12">
    <h3 class="text-lg font-semibold mb-3">All Department Changes</h3>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="bg-gray-50">
            <th class="px-3 py-2 text-left font-medium text-gray-700 border-b">Department</th>
            <th class="px-3 py-2 text-right font-medium text-gray-700 border-b">{amendment.adoptedLabel}</th>
            <th class="px-3 py-2 text-right font-medium text-gray-700 border-b">{amendment.amendedLabel}</th>
            <th class="px-3 py-2 text-right font-medium text-gray-700 border-b">Change</th>
            <th class="px-3 py-2 text-right font-medium text-gray-700 border-b">%</th>
          </tr>
        </thead>
        <tbody>
          {data.departmentChanges.map((d: any, i: number) => (
            <tr class={i % 2 === 0 ? 'bg-white' : 'bg-gray-50'}>
              <td class="px-3 py-1.5 border-b border-gray-100">
                <a href={`${prefix}/sections/${d.slug}/`} class="text-ps-blue-600 hover:underline">{d.department}</a>
              </td>
              <td class="px-3 py-1.5 border-b border-gray-100 text-right tabular-nums">${Math.round(d.budgetAdopted).toLocaleString()}</td>
              <td class="px-3 py-1.5 border-b border-gray-100 text-right tabular-nums">${Math.round(d.budgetAmended).toLocaleString()}</td>
              <td class={`px-3 py-1.5 border-b border-gray-100 text-right tabular-nums ${d.dollarChange > 0 ? 'text-green-600' : d.dollarChange < 0 ? 'text-ps-red-600' : 'text-gray-400'}`}>
                {d.dollarChange === 0 ? '—' : `${d.dollarChange > 0 ? '+' : ''}${Math.round(d.dollarChange).toLocaleString()}`}
              </td>
              <td class={`px-3 py-1.5 border-b border-gray-100 text-right tabular-nums ${d.dollarChange > 0 ? 'text-green-600' : d.dollarChange < 0 ? 'text-ps-red-600' : 'text-gray-400'}`}>
                {d.pctChange === null || d.dollarChange === 0 ? '—' : `${d.pctChange > 0 ? '+' : ''}${d.pctChange}%`}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</Base>
