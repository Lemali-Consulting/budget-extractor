---
import Base from '../layouts/Base.astro';
import BudgetBalls from '../components/BudgetBalls.tsx';
import departmentBudgets from '../data/views/department-budgets.json';
import expenditureDetails from '../data/views/department-expenditure-details.json';

const budgetRows = departmentBudgets as { department: string; slug: string; year: string; amount: number }[];
const total2026 = budgetRows.filter(r => r.year === '2026 Budget').reduce((s, r) => s + r.amount, 0);
const deptCount = new Set(budgetRows.filter(r => r.year === '2026 Budget').map(r => r.slug)).size;
---

<Base title="Budget Balls — Where the Money Goes">
  <nav class="text-sm text-gray-500 mb-4">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span class="mx-1" aria-hidden="true">/</span>
    <span>Budget Balls</span>
  </nav>

  <h1 class="text-3xl font-bold mb-2">Where the Money Goes</h1>
  <p class="text-gray-600 mb-6">
    Every ball represents a unit of city spending across {deptCount} departments totaling ${(total2026 / 1_000_000).toFixed(0)}M.
    Click a department to see its expenditure breakdown.
  </p>

  <BudgetBalls
    client:load
    departmentBudgets={departmentBudgets}
    expenditureDetails={expenditureDetails}
  />

  <div class="mt-8 text-sm text-gray-500">
    <p>
      Data: City of Pittsburgh FY2026 Operating Budget. Ball count adjusts by screen size
      for readability. Hover over clusters for details, click to drill into expenditure categories.
    </p>
  </div>
</Base>
