---
import Base from '../layouts/Base.astro';
import FlowSankey from '../components/FlowSankey.tsx';
import type { FlowNode, FlowLink } from '../components/FlowSankey.tsx';
import { HEADLINE } from '../lib/budget-year';
import { capitalizeFirst, sentenceCase } from '../lib/text-case';
import { publishedSectionHrefs } from '../lib/published-pages';
import { revenueColor, capitalSourceColor, FUND_BALANCE_COLOR } from '../lib/flow-colors';
import { useOfFundBalance } from '../lib/fund-balance';
import { colorForSlug, GROUP_COLORS } from '../lib/department-groups';

const {
  revenueWaterfall,
  departmentBudgets,
  capitalFundingSources: capitalFunding,
} = HEADLINE.views;

interface RevenueRow { label: string; amount: number; type: string }
interface DeptRow { department: string; slug: string; year: string; amount: number; fund: string }
interface CapitalRow { project: string; source: string; year: string; amount: number }

function fmtM(n: number): string {
  return `$${(n / 1_000_000).toFixed(1)}M`;
}

/** Whole millions ("$727M"), the way a headline total is quoted. */
function fmtWholeM(n: number): string {
  return `$${Math.round(n / 1_000_000)}M`;
}

// ---------- Operating flow: revenue → trunk → departments ----------

const revenue = revenueWaterfall as RevenueRow[];
const revenueTotal = revenue.reduce((s, r) => s + r.amount, 0);
// Revenue alone falls short of spending; the budget draws on the fund balance
// for the rest, and that draw sits on the left beside revenue.
const fundBalanceDraw = useOfFundBalance(HEADLINE);
const FUND_BALANCE_NODE_ID = 'source:use-of-fund-balance';

// Operating departments only — trust funds are not part of the operating flow.
const currentDepts = (departmentBudgets as DeptRow[]).filter((r) => r.year === HEADLINE.columns.budget && r.fund === 'operating');
const deptTotal = currentDepts.reduce((s, r) => s + r.amount, 0);

// Group small departments (<1% of dept total) into "Other departments".
const DEPT_THRESHOLD = 0.01;
const bigDepts = currentDepts.filter((d) => d.amount / deptTotal >= DEPT_THRESHOLD);
const smallDepts = currentDepts.filter((d) => d.amount / deptTotal < DEPT_THRESHOLD);
const otherDeptAmount = smallDepts.reduce((s, d) => s + d.amount, 0);

const operatingNodes: FlowNode[] = [
  ...revenue.map((r) => ({
    id: `rev:${r.label}`,
    label: r.label,
    category: 'revenue',
    color: revenueColor(r.label),
  })),
  ...(fundBalanceDraw
    ? [{ id: FUND_BALANCE_NODE_ID, label: 'Use of fund balance', category: 'revenue', color: FUND_BALANCE_COLOR }]
    : []),
  { id: 'trunk', label: capitalizeFirst(HEADLINE.operatingName), category: 'trunk' },
  ...bigDepts
    .slice()
    .sort((a, b) => b.amount - a.amount)
    .map((d) => ({
      id: `dep:${d.slug}`,
      label: d.department,
      category: 'department',
      color: colorForSlug(d.slug),
      href: publishedSectionHrefs(HEADLINE)[d.slug],
    })),
  ...(smallDepts.length > 0
    ? [{
        id: 'dep:other',
        label: `Other (${smallDepts.length} departments)`,
        category: 'department-other',
      }]
    : []),
];

const operatingLinks: FlowLink[] = [
  ...revenue.map((r) => ({ source: `rev:${r.label}`, target: 'trunk', value: r.amount })),
  ...(fundBalanceDraw ? [{ source: FUND_BALANCE_NODE_ID, target: 'trunk', value: fundBalanceDraw }] : []),
  ...bigDepts.map((d) => ({
    source: 'trunk',
    target: `dep:${d.slug}`,
    value: d.amount,
    color: colorForSlug(d.slug),
  })),
  ...(smallDepts.length > 0
    ? [{ source: 'trunk', target: 'dep:other', value: otherDeptAmount }]
    : []),
];

// ---------- Capital flow: source → project → year ----------

// The plan the capital document totals runs from the budget year on (2027-2032
// on p. 24). Its 2026 column is detailed only for projects still funded later,
// so it falls short of the plan's own 2026 row; it is left out (fact-check
// sheet "1126", row 7, column G; Max, 2026-11-16).
const capital = (capitalFunding as CapitalRow[]).filter((r) => Number(r.year) >= HEADLINE.year);
const capitalTotal = capital.reduce((s, r) => s + r.amount, 0);

// Aggregate by project to find top projects.
const projectTotals = new Map<string, number>();
for (const r of capital) {
  projectTotals.set(r.project, (projectTotals.get(r.project) ?? 0) + r.amount);
}
const TOP_N = 18;
const sortedProjects = [...projectTotals.entries()].sort((a, b) => b[1] - a[1]);
const topProjects = new Set(sortedProjects.slice(0, TOP_N).map(([p]) => p));

function projectId(project: string): string {
  return topProjects.has(project) ? `proj:${project}` : 'proj:other';
}

// source → project links
const srcProjMap = new Map<string, number>();
const projYearMap = new Map<string, number>();
// Track funding mix per project so we can color each project node by its
// dominant source — that way the source palette propagates into the
// project → year links too.
const projSourceMix = new Map<string, Map<string, number>>();
for (const r of capital) {
  const pid = projectId(r.project);
  const sk = `${r.source}|${pid}`;
  srcProjMap.set(sk, (srcProjMap.get(sk) ?? 0) + r.amount);
  const pk = `${pid}|${r.year}`;
  projYearMap.set(pk, (projYearMap.get(pk) ?? 0) + r.amount);
  const mix = projSourceMix.get(pid) ?? new Map<string, number>();
  mix.set(r.source, (mix.get(r.source) ?? 0) + r.amount);
  projSourceMix.set(pid, mix);
}

function dominantSourceColor(pid: string): string {
  const mix = projSourceMix.get(pid);
  if (!mix) return '#94a3b8';
  let topSource = '';
  let topAmount = -1;
  for (const [src, amt] of mix) {
    if (amt > topAmount) {
      topAmount = amt;
      topSource = src;
    }
  }
  return capitalSourceColor(topSource);
}

const sources = [...new Set(capital.map((r) => r.source))];
const years = [...new Set(capital.map((r) => r.year))].sort();

const capitalNodes: FlowNode[] = [
  ...sources.map((s) => ({
    id: `src:${s}`,
    label: sentenceCase(s),
    category: 'source',
    color: capitalSourceColor(s),
  })),
  ...sortedProjects.slice(0, TOP_N).map(([p]) => {
    return {
      id: `proj:${p}`,
      label: p.length > 48 ? p.slice(0, 45).trimEnd() + "…" : p,
      category: 'project',
      color: dominantSourceColor(`proj:${p}`),
    };
  }),
  ...(sortedProjects.length > TOP_N
    ? [{
        id: 'proj:other',
        label: `Other (${sortedProjects.length - TOP_N} projects)`,
        category: 'project-other',
      }]
    : []),
  ...years.map((y) => ({ id: `yr:${y}`, label: y, category: 'year' })),
];

const capitalLinks: FlowLink[] = [
  ...[...srcProjMap.entries()].map(([k, v]) => {
    const [source, target] = k.split('|');
    return { source: `src:${source}`, target, value: v };
  }),
  ...[...projYearMap.entries()].map(([k, v]) => {
    const [source, year] = k.split('|');
    return { source, target: `yr:${year}`, value: v };
  }),
];
---

<Base
  title="Money flow"
  description={`Where Pittsburgh's ${HEADLINE.budgetName.toLowerCase()} comes from and where it goes — operating revenue and capital spending visualized as flows.`}
  ogDescription={`Operating: ${fmtM(revenueTotal)} revenue across ${revenue.length} sources flows to ${currentDepts.length} departments. Capital: ${fmtM(capitalTotal)} across ${sources.length} funding sources, ${sortedProjects.length} projects, ${years.length} years.`}
>
  <h1 class="text-3xl font-bold mb-2">Money flow</h1>
  <p class="text-gray-600 mb-6 max-w-3xl">
    Where the city's money comes from, and where it goes. Hover over any band to
    trace the dollars; click a department, or the band leading to it on the right, to open its page.
  </p>

  <!-- Operating -->
  <section class="mb-12">
    <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-x-4 mb-2">
      <h2 class="text-xl font-semibold">Operating budget — revenue to departments</h2>
      <span class="text-sm text-gray-500 whitespace-nowrap" data-testid="operating-flow-total">{HEADLINE.budgetName} · {fmtWholeM(deptTotal)}</span>
    </div>
    <p class="text-sm text-gray-500 mb-4 max-w-3xl">
      On the left, revenue in {revenue.length} categories{fundBalanceDraw ? ' and the use of fund balance' : ''} feed
      the city's general budget, which is then distributed across
      departments on the right. Departments smaller than 1% are
      grouped together. Every amount is the budget's own figure.
    </p>
    <div class="bg-white rounded-lg border p-4">
      <FlowSankey
        nodes={operatingNodes}
        links={operatingLinks}
        width={1100}
        height={Math.max(760, bigDepts.length * 38)}
        interactive
        showLabels
        totalAmount={deptTotal}
        client:visible
      />
      <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-xs text-gray-600">
        <span class="text-gray-400">Departments grouped by:</span>
        {Object.entries(GROUP_COLORS).map(([name, color]) => (
          <span class="inline-flex items-center gap-1.5">
            <span class="inline-block w-3 h-3 rounded-sm" style={`background-color: ${color}`}></span>
            {name}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- Capital -->
  <section class="mb-12">
    <div class="flex items-baseline justify-between mb-2">
      <h2 class="text-xl font-semibold">Capital plan — sources, projects, years</h2>
      <span class="text-sm text-gray-500">{years[0]}–{years[years.length - 1]} · {fmtM(capitalTotal)}</span>
    </div>
    <p class="text-sm text-gray-500 mb-4 max-w-3xl">
      The six-year capital plan moves money from {sources.length} funding sources
      (bonds, PAYGO, CDBG, other) through {sortedProjects.length} projects and
      out across {years.length} fiscal years. Smaller projects are grouped into
      "Other" to keep labels readable.
    </p>
    <div class="bg-white rounded-lg border p-4">
      <FlowSankey
        nodes={capitalNodes}
        links={capitalLinks}
        width={1100}
        height={820}
        interactive
        showLabels
        totalAmount={capitalTotal}
        client:visible
      />
    </div>
  </section>

  <p class="text-xs text-gray-400">
    Source: tables extracted from the City of Pittsburgh's {HEADLINE.documentsName}.
  </p>
</Base>
