---
/**Story index — curated data stories about the Pittsburgh budget.*/
import Base from '../../layouts/Base.astro';
import { BUDGET_2026 } from '../../lib/budget-year';

const stories = [
  {
    slug: 'biggest-budget-shifts',
    title: '5 biggest budget shifts in 2026',
    subtitle: 'Where the money moved — and what it tells us about city priorities',
    date: 'March 2026',
    color: 'bg-ps-yellow-50 border-ps-yellow-200',
  },
  {
    slug: 'where-your-tax-dollar-goes',
    title: 'Where your tax dollar goes',
    subtitle: 'A cent-by-cent breakdown of Pittsburgh\'s operating budget',
    date: 'March 2026',
    color: 'bg-ps-blue-50 border-ps-blue-200',
  },
  {
    slug: 'city-workforce',
    title: 'The City\'s Workforce in 2026',
    subtitle: 'Who works for Pittsburgh, what they earn, and what\'s changing',
    date: 'March 2026',
    color: 'bg-cyan-50 border-cyan-200',
  },
  {
    slug: 'capital-plan',
    title: 'What\'s getting built: the capital plan',
    subtitle: 'A $960 million investment in Pittsburgh\'s infrastructure',
    date: 'March 2026',
    color: 'bg-orange-50 border-orange-200',
  },
];
---

<Base title="Stories" budgetYear={BUDGET_2026} description="Curated data stories about the City of Pittsburgh's FY2026 budget.">
  <h1 class="text-3xl font-bold mb-2">Budget stories</h1>
  <p class="text-gray-600 mb-8 text-lg">The Pittsburgh budget, told through data. Each story pairs charts with plain-language context to explain what's happening and why it matters.</p>

  <div class="grid gap-6 max-w-3xl">
    {stories.map(story => (
      <a href={`/stories/${story.slug}/`} class={`block rounded-xl border p-6 hover:shadow-md transition-shadow ${story.color}`}>
        <div class="text-xs text-gray-500 mb-2">{story.date}</div>
        <h2 class="text-xl font-bold mb-1">{story.title}</h2>
        <p class="text-gray-600">{story.subtitle}</p>
      </a>
    ))}
  </div>
</Base>
