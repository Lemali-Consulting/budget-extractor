---
/**Story: What's Getting Built — The Capital Plan.*/
import Story from '../../layouts/Story.astro';
import FundingSourceChart from '../../components/FundingSourceChart.tsx';
import { BUDGET_2026 } from '../../lib/budget-year';

const funding = BUDGET_2026.views.capitalFundingSources as any[];
const projects = BUDGET_2026.views.capitalProjects as any[];

const capital2026 = funding.filter(r => r.year === '2026').reduce((s: number, r: any) => s + r.amount, 0);
const capitalTotal = funding.filter(r => parseInt(r.year) >= 2026).reduce((s: number, r: any) => s + r.amount, 0);

// Aggregate funding by source for 2026
const sourceMap = new Map<string, number>();
for (const r of funding.filter((r: any) => r.year === '2026')) {
  sourceMap.set(r.source, (sourceMap.get(r.source) || 0) + r.amount);
}
const sources = [...sourceMap.entries()].sort((a, b) => b[1] - a[1]);

// Top projects by 2026 funding (exclude items without funding data like intro pages)
const topProjects = [...projects]
  .filter((p: any) => p.funding)
  .sort((a: any, b: any) => (b.funding?.['2026'] || 0) - (a.funding?.['2026'] || 0))
  .slice(0, 8);

function fmtM(n: number): string {
  if (Math.abs(n) >= 1_000_000) return `$${(n / 1_000_000).toFixed(1)}M`;
  if (Math.abs(n) >= 1_000) return `$${(n / 1_000).toFixed(0)}K`;
  return `$${n.toFixed(0)}`;
}
function fmtB(n: number): string {
  return `$${(n / 1_000_000_000).toFixed(2)}B`;
}
---

<Story
  budgetYear={BUDGET_2026}
  title="What's Getting Built: The Capital Plan"
  subtitle={`A ${fmtB(capitalTotal)} investment in Pittsburgh's infrastructure`}
  description="Pittsburgh's six-year capital improvement plan funds roads, bridges, buildings, and technology. Here's where the money is going."
  date="March 2026"
>
  <p>
    While the operating budget covers day-to-day expenses, Pittsburgh's <strong>capital budget</strong> funds
    long-term infrastructure: road repairs, bridge rehabilitation, building renovations, vehicle purchases,
    and technology upgrades. The six-year plan (2026-2031) totals <strong>{fmtB(capitalTotal)}</strong>,
    with <strong>{fmtM(capital2026)}</strong> planned for 2026 alone.
  </p>

  <h2>How it's funded</h2>

  <div class="chart-container">
    <FundingSourceChart data={funding} client:load />
  </div>

  <p>
    Capital spending is funded from multiple sources, each with different constraints:
  </p>

  <ul class="list-disc ml-6 mb-4 text-lg text-gray-700 leading-relaxed space-y-1">
    {sources.map(([source, amount]) => (
      <li>
        <strong>{source}</strong> — {fmtM(amount)} in 2026
        {source === 'BOND' ? ' (long-term borrowing, repaid through debt service)' :
         source === 'PAYGO' ? ' (pay-as-you-go from operating revenue)' :
         source === 'CDBG' ? ' (federal Community Development Block Grant)' :
         ' (other federal, state, or grant funding)'}
      </li>
    ))}
  </ul>

  {topProjects.length > 0 && (
    <>
      <h2>Biggest capital projects in 2026</h2>

      <div class="overflow-x-auto my-4">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-gray-50">
              <th class="px-3 py-2 text-left font-medium text-gray-700 border-b">Project</th>
              <th class="px-3 py-2 text-right font-medium text-gray-700 border-b">2026</th>
              <th class="px-3 py-2 text-right font-medium text-gray-700 border-b">6-Year Total</th>
            </tr>
          </thead>
          <tbody>
            {topProjects.map((p: any, i: number) => (
              <tr class={i % 2 === 0 ? 'bg-white' : 'bg-gray-50'}>
                <td class="px-3 py-1.5 border-b border-gray-100">
                  {p.slug
                    ? <a href={`/capital/${p.slug}/`} class="text-blue-600 hover:underline">{p.title || p.project}</a>
                    : (p.title || p.project)
                  }
                </td>
                <td class="px-3 py-1.5 border-b border-gray-100 text-right tabular-nums">{fmtM(p.funding?.['2026'] || 0)}</td>
                <td class="px-3 py-1.5 border-b border-gray-100 text-right tabular-nums">{fmtM(p.funding?.['Total 2026-2031'] || 0)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  )}

  <h2>Operating vs. Capital: what's the difference?</h2>

  <p>
    Think of the <strong>operating budget</strong> as your household's monthly expenses — groceries,
    utilities, rent. The <strong>capital budget</strong> is like saving up for a new roof or renovating
    the kitchen. Operating costs recur every year; capital projects are one-time investments
    in long-lived assets.
  </p>

  <p>
    The two budgets interact: bond-funded capital projects create <em>debt service</em> obligations
    that show up in the operating budget for years to come. And PAYGO capital spending directly
    reduces money available for operations.
  </p>

  <div class="callout">
    <p>
      <strong>Browse all projects:</strong> The <a href="/2026/capital/" class="underline">Capital Budget section</a> has
      the complete project list with six-year funding breakdowns.
    </p>
  </div>
</Story>
