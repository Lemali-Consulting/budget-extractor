---
/**Story: The City's Workforce in 2026.*/
import Story from '../../layouts/Story.astro';
import PersonnelChangesChart from '../../components/PersonnelChangesChart.tsx';
import SimpleBars from '../../components/SimpleBars.tsx';
import personnelByDept from '../../data/views/personnel-by-department.json';
import budgetChanges from '../../data/views/budget-changes.json';

const personnel = personnelByDept as any[];
const changes = budgetChanges as any;

const totalFte2026 = Math.round(personnel.reduce((s, d) => s + d.totalFte2026, 0));
const totalFte2025 = Math.round(personnel.reduce((s, d) => s + d.totalFte2025, 0));
const fteChange = totalFte2026 - totalFte2025;
const totalPayroll = personnel.reduce((s, d) => s + d.totalBudget2026, 0);

// Top departments by headcount
const topByFte = [...personnel]
  .sort((a, b) => b.totalFte2026 - a.totalFte2026)
  .slice(0, 8)
  .map(d => ({ label: d.department, value: d.totalFte2026 }));

// Departments with biggest FTE changes
const fteChanges = personnel
  .map(d => ({
    dept: d.department,
    change: d.totalFte2026 - d.totalFte2025,
  }))
  .filter(d => d.change !== 0)
  .sort((a, b) => b.change - a.change);
const fteIncreases = fteChanges.filter(d => d.change > 0);
const fteDecreases = fteChanges.filter(d => d.change < 0);

// New position categories
const newByDept = new Map<string, number>();
for (const p of changes.newPositions) {
  newByDept.set(p.department, (newByDept.get(p.department) || 0) + p.fte);
}
const topNewDepts = [...newByDept.entries()]
  .sort((a, b) => b[1] - a[1])
  .slice(0, 5);

function fmtM(n: number): string {
  return `$${(n / 1_000_000).toFixed(1)}M`;
}
---

<Story
  title="The City's Workforce in 2026"
  subtitle="Who works for Pittsburgh, what they earn, and what's changing"
  description="Pittsburgh's 2026 budget funds 3,500+ city employees. Here's how the workforce is distributed and what positions are being added or cut."
  date="March 2026"
>
  <p>
    The City of Pittsburgh's 2026 budget funds <strong>{totalFte2026.toLocaleString()} full-time equivalent
    positions</strong> at a total payroll cost of <strong>{fmtM(totalPayroll)}</strong>. That's
    a net change of {fteChange >= 0 ? '+' : ''}{fteChange} FTE from 2025 (reflecting both position changes and adjustments to existing roles).
  </p>

  <h2>Where city employees work</h2>

  <div class="chart-container">
    <SimpleBars items={topByFte} format="fte" client:load />
  </div>

  <p>
    Public safety dominates the headcount. The Bureau of Police ({Math.round(personnel.find(d => d.slug === 'bureau-of-police')?.totalFte2026 || 0)} FTE),
    Bureau of Fire ({Math.round(personnel.find(d => d.slug === 'bureau-of-fire')?.totalFte2026 || 0)} FTE), and
    EMS ({Math.round(personnel.find(d => d.slug === 'bureau-of-emergency-medical-services')?.totalFte2026 || 0)} FTE)
    together employ more than half of all city workers. Operations (public works)
    is the largest non-public-safety employer.
  </p>

  <h2>Who's hiring, who's cutting</h2>

  <div class="chart-container">
    <PersonnelChangesChart data={personnelByDept} client:load />
  </div>

  <p>
    Not every department is moving in the same direction. {fteIncreases.length > 0 &&
    `${fteIncreases[0].dept} added the most positions (+${Math.round(fteIncreases[0].change)}).`}
    {fteDecreases.length > 0 &&
    ` Meanwhile, ${fteDecreases[fteDecreases.length - 1].dept} saw the largest reduction (${Math.round(fteDecreases[fteDecreases.length - 1].change)}).`}
  </p>

  <h2>New positions: what's being created</h2>

  <p>
    The city is creating <strong>{changes.newPositions.length} new positions</strong> across
    {newByDept.size} departments, while eliminating {changes.eliminatedPositions.length}. The departments
    getting the most new hires:
  </p>

  <div class="overflow-x-auto my-4">
    <table class="w-full text-sm">
      <thead>
        <tr class="bg-gray-50">
          <th class="px-3 py-2 text-left font-medium text-gray-700 border-b">Department</th>
          <th class="px-3 py-2 text-right font-medium text-gray-700 border-b">New FTE</th>
        </tr>
      </thead>
      <tbody>
        {topNewDepts.map(([dept, fte], i) => (
          <tr class={i % 2 === 0 ? 'bg-white' : 'bg-gray-50'}>
            <td class="px-3 py-1.5 border-b border-gray-100">{dept}</td>
            <td class="px-3 py-1.5 border-b border-gray-100 text-right text-green-600 font-medium tabular-nums">+{fte}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  {changes.shiftedPositions.length > 0 && (
    <>
      <h2>Positions on the move</h2>
      <p>
        Beyond new hires and cuts, <strong>{changes.shiftedPositions.length} positions shifted</strong> between
        departments — same job title, different organizational home. This often reflects administrative
        reorganization rather than new spending.
      </p>
    </>
  )}

  <div class="callout">
    <p>
      <strong>Explore individual positions:</strong> The <a href="/personnel/" class="underline">Personnel Explorer</a> lets
      you search and filter every budgeted position by department, title, and salary.
    </p>
  </div>
</Story>
