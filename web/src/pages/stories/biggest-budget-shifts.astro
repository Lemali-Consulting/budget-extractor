---
/**Story: 5 Biggest Budget Shifts in 2026.*/
import Story from '../../layouts/Story.astro';
import ChangesChart from '../../components/ChangesChart.tsx';
import { BUDGET_2026 } from '../../lib/budget-year';

const data = BUDGET_2026.views.budgetChanges as any;
const topInc = data.topIncreases.slice(0, 5);
const topDec = data.topDecreases.slice(0, 5);
const totalChange = data.totalBudget2026 - data.totalBudget2025;
const changePct = ((totalChange / data.totalBudget2025) * 100).toFixed(1);

function fmtM(n: number): string {
  return `$${(Math.abs(n) / 1_000_000).toFixed(1)}M`;
}
---

<Story
  budgetYear={BUDGET_2026}
  title="5 biggest budget shifts in 2026"
  subtitle="Where the money moved — and what it tells us about city priorities"
  description="The top budget increases and decreases in Pittsburgh's FY2026 operating budget, and what they mean."
  date="March 2026"
>
  <p>
    Across the {data.departmentChanges.length} departments tracked in our comparison, total budgets
    grew by <strong>{changePct}%</strong>, from {fmtM(data.totalBudget2025)} to {fmtM(data.totalBudget2026)}.
    But the headline number masks significant shifts underneath — some departments saw double-digit
    increases while others were cut. Here are the five biggest moves.
  </p>

  <h2>The biggest increases</h2>

  <div class="chart-container">
    <ChangesChart data={topInc} title="" color="#16a34a" client:load />
  </div>

  {topInc.slice(0, 3).map((dept: any, i: number) => (
    <>
      <h3>{i + 1}. {dept.department}: +{fmtM(dept.dollarChange)} (+{dept.pctChange}%)</h3>
      <p>
        {dept.department} saw a {fmtM(dept.dollarChange)} increase ({dept.pctChange}%) year-over-year,
        moving from {fmtM(dept.budget2025)} to {fmtM(dept.budget2026)}.
      </p>
    </>
  ))}

  <h2>The biggest decreases</h2>

  <div class="chart-container">
    <ChangesChart data={topDec} title="" color="#DC2725" client:load />
  </div>

  {topDec.slice(0, 2).map((dept: any, i: number) => (
    <>
      <h3>{i + 4}. {dept.department}: -{fmtM(dept.dollarChange)} ({dept.pctChange}%)</h3>
      <p>
        {dept.department} saw the {i === 0 ? 'largest' : 'second-largest'} dollar decrease,
        dropping {fmtM(dept.dollarChange)} ({dept.pctChange}%) from {fmtM(dept.budget2025)} to {fmtM(dept.budget2026)}.
      </p>
    </>
  ))}

  <div class="callout">
    <p>
      <strong>The staffing picture:</strong> Across the city, {data.newPositions.length} positions are
      being created and {data.eliminatedPositions.length} eliminated — a net change of
      {data.totalFte2026 - data.totalFte2025 > 0 ? '+' : ''}{Math.round(data.totalFte2026 - data.totalFte2025)} FTE.
      See the full breakdown on the <a href="/2026/changes/" class="underline">What changed</a> page.
    </p>
  </div>
</Story>
