---
import Base from '../layouts/Base.astro';
import DataExplorer from '../components/explorer/DataExplorer.tsx';
import tablesIndex from '../data/views/tables-index.json';
import budgetData from '../data/budget-data.json';
import capitalData from '../data/capital-budget-data.json';

const sections = [...budgetData.sections, ...capitalData.sections];
---

<Base title="Data Explorer" fullWidth>
  <DataExplorer tablesIndex={tablesIndex} sections={sections} client:load />
</Base>
