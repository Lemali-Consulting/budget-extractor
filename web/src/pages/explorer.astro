---
import Base from '../layouts/Base.astro';
import DataExplorer from '../components/explorer/DataExplorer.tsx';
import { HEADLINE } from '../lib/budget-year';
import { publishedSectionHrefs } from '../lib/published-pages';

const sections = [...HEADLINE.operating.sections, ...HEADLINE.capital.sections];
---

<Base title="Data explorer" fullWidth>
  <DataExplorer tablesIndex={HEADLINE.views.tablesIndex} sections={sections} year={HEADLINE.year} sectionHrefs={publishedSectionHrefs(HEADLINE)} client:load />
</Base>
