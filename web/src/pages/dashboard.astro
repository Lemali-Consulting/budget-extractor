---
import Base from '../layouts/Base.astro';
import SiteSearch from '../components/SiteSearch.tsx';
import BudgetChart from '../components/BudgetChart.tsx';
import WaterfallChart from '../components/WaterfallChart.tsx';
import FundingSourceChart from '../components/FundingSourceChart.tsx';
import PersonnelTreemap from '../components/PersonnelTreemap.tsx';
import EmbedButton from '../components/EmbedButton.tsx';
import { HEADLINE } from '../lib/budget-year';
import { operating, sumFor } from '../lib/department-budgets';
import PersonnelCard from '../components/PersonnelCard.astro';

const {
  departmentBudgets: budgetRows,
  revenueWaterfall,
  capitalFundingSources: capitalFunding,
  personnelByDepartment: personnelByDept,
} = HEADLINE.views;
const { columns } = HEADLINE;

// Compute summary stats — operating budget only; trust funds reported separately
const totalCurrent = sumFor(budgetRows, 'operating', columns.budget);
const totalPrior = sumFor(budgetRows, 'operating', columns.priorBudget);
const trustTotalCurrent = sumFor(budgetRows, 'trust', columns.budget);
const budgetChange = totalPrior > 0 ? ((totalCurrent - totalPrior) / totalPrior * 100) : 0;
const deptCount = new Set(operating(budgetRows).map(r => r.slug)).size;

const revenueTotal = (revenueWaterfall as { amount: number }[]).reduce((s, r) => s + r.amount, 0);

const capitalRows = capitalFunding as { year: string; amount: number }[];
const capitalTotal = capitalRows.filter(r => parseInt(r.year) >= HEADLINE.year).reduce((s, r) => s + r.amount, 0);
// Current year only
const capitalCurrent = (capitalFunding as { year: string; amount: number }[])
  .filter(r => r.year === String(HEADLINE.year))
  .reduce((s, r) => s + r.amount, 0);

function fmtM(n: number): string {
  return `$${(n / 1_000_000).toFixed(1)}M`;
}
---

<Base title="Budget Dashboard">
  <nav class="text-sm text-gray-500 mb-4">
    <a href="/" class="hover:text-ps-blue-600">Home</a>
    <span class="mx-1" aria-hidden="true">/</span>
    <span>Dashboard</span>
  </nav>

  <h1 class="text-3xl font-bold mb-2">{HEADLINE.fiscalLabel} Budget Dashboard</h1>
  <p class="text-gray-600 mb-4">City of Pittsburgh budget at a glance — operating, capital, and personnel.</p>

  <div class="mb-6">
    <SiteSearch client:load />
  </div>

  <!-- Summary stats -->
  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 mb-10">
    <div class="bg-white rounded-lg border p-4">
      <div class="text-xs text-gray-400 uppercase tracking-wide">Operating Budget</div>
      <div class="text-2xl font-bold text-ps-blue-900 mt-1">{fmtM(totalCurrent)}</div>
      <div class={`text-sm mt-0.5 ${budgetChange >= 0 ? 'text-green-600' : 'text-ps-red-600'}`}>
        {budgetChange >= 0 ? '↑ +' : '↓ '}{budgetChange.toFixed(1)}% vs {HEADLINE.priorYear}
      </div>
    </div>
    <div class="bg-white rounded-lg border p-4" data-testid="trust-fund-total">
      <div class="text-xs text-gray-400 uppercase tracking-wide">Trust Funds</div>
      <div class="text-2xl font-bold text-slate-700 mt-1" data-testid="trust-fund-total-amount">{fmtM(trustTotalCurrent)}</div>
      <div class="text-sm text-gray-500 mt-0.5">Separate from operating</div>
      <a href="/trust-funds/" class="block text-xs text-ps-blue-600 hover:underline mt-1">See the funds &rarr;</a>
    </div>
    <div class="bg-white rounded-lg border p-4">
      <div class="text-xs text-gray-400 uppercase tracking-wide">Projected Revenue</div>
      <div class="text-2xl font-bold text-green-900 mt-1">{fmtM(revenueTotal)}</div>
      <div class="text-sm text-gray-500 mt-0.5">{(revenueWaterfall as any[]).length} sources</div>
    </div>
    <div class="bg-white rounded-lg border p-4">
      <div class="text-xs text-gray-400 uppercase tracking-wide">Capital ({HEADLINE.year})</div>
      <div class="text-2xl font-bold text-ps-yellow-900 mt-1">{fmtM(capitalCurrent)}</div>
      <div class="text-sm text-gray-500 mt-0.5">6-yr plan: {fmtM(capitalTotal)}</div>
    </div>
    <PersonnelCard budgetYear={HEADLINE} />
  </div>

  <!-- Operating Budget section -->
  <div class="mb-12">
    <div class="flex items-baseline justify-between mb-1">
      <h2 class="text-2xl font-semibold">Operating Budget</h2>
      <a href="/operating/" class="text-sm text-ps-blue-500 hover:text-ps-blue-700">Browse all {deptCount} departments &rarr;</a>
    </div>
    <p class="text-gray-500 text-sm mb-6">Department spending and revenue for day-to-day city operations.</p>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <div class="bg-white rounded-lg border p-5">
        <div class="flex items-start justify-between mb-1">
          <h3 class="text-lg font-semibold">Department Comparison</h3>
          <EmbedButton embedPath="/embed/department-comparison/" client:load />
        </div>
        <p class="text-sm text-gray-500 mb-3">Top departments by budget total.</p>
        <BudgetChart data={operating(budgetRows)} client:load />
      </div>

      <div class="bg-white rounded-lg border p-5">
        <div class="flex items-start justify-between">
          <div />
          <EmbedButton embedPath="/embed/revenue-breakdown/" client:load />
        </div>
        <WaterfallChart data={revenueWaterfall} yearLabel={HEADLINE.label} client:load />
      </div>
    </div>
  </div>

  <!-- Capital Budget section -->
  <div class="mb-12">
    <div class="flex items-baseline justify-between mb-1">
      <h2 class="text-2xl font-semibold">Capital Budget</h2>
      <a href="/capital/" class="text-sm text-ps-blue-500 hover:text-ps-blue-700">Browse all projects &rarr;</a>
    </div>
    <p class="text-gray-500 text-sm mb-6">Six-year capital improvement plan — infrastructure, facilities, and major projects.</p>

    <div class="bg-white rounded-lg border p-5 max-w-3xl">
      <div class="flex justify-end mb-1">
        <EmbedButton embedPath="/embed/capital-funding/" client:load />
      </div>
      <FundingSourceChart data={capitalFunding} client:load />
    </div>
  </div>

  <!-- Personnel section -->
  <div class="mb-12">
    <div class="flex items-baseline justify-between mb-1">
      <h2 class="text-2xl font-semibold">Personnel</h2>
      <a href="/personnel/" class="text-sm text-ps-blue-500 hover:text-ps-blue-700">Explore all positions &rarr;</a>
    </div>
    <p class="text-gray-500 text-sm mb-6">Staffing levels and payroll across city departments.</p>

    <div class="bg-white rounded-lg border p-5">
      <PersonnelTreemap data={personnelByDept} routePrefix={HEADLINE.routePrefix} client:load />
    </div>
  </div>
</Base>
