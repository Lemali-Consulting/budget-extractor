---
import Base from '../../layouts/Base.astro';
import TableViewer from '../../components/TableViewer.astro';
import budgetData from '../../data/budget-data.json';

export function getStaticPaths() {
  return budgetData.sections.map((s) => ({
    params: { slug: s.slug },
    props: { section: s },
  }));
}

const { section } = Astro.props;
---

<Base title={section.title}>
  <nav class="text-sm text-gray-500 mb-4">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span class="mx-1">/</span>
    <span>{section.title}</span>
  </nav>

  <h1 class="text-3xl font-bold mb-2">{section.title}</h1>
  <p class="text-gray-500 mb-6">
    Section {section.section_number}
    {section.start_page && section.end_page ? ` · Pages ${section.start_page}–${section.end_page}` : ''}
    · {section.tables.length} {section.tables.length === 1 ? 'table' : 'tables'}
  </p>

  {section.tables.length === 0 ? (
    <p class="text-gray-400 italic">No tables extracted for this section.</p>
  ) : (
    section.tables.map((table) => (
      <TableViewer table={table} />
    ))
  )}
</Base>
