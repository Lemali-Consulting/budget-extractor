---
/**Headline operating section page; the body is shared with the archive routes.*/
import SectionPage from '../../components/pages/SectionPage.astro';
import { HEADLINE } from '../../lib/budget-year';
import { sectionStaticPaths } from '../../lib/static-paths';

export function getStaticPaths() {
  return sectionStaticPaths(HEADLINE);
}

const { section, prev, next } = Astro.props;
---

<SectionPage budgetYear={HEADLINE} section={section} prev={prev} next={next} />
