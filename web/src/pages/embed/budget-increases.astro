---
/**Embeddable chart: biggest budget increases.*/
import Embed from '../../layouts/Embed.astro';
import ChangesChart from '../../components/ChangesChart.tsx';
import EmbedWrapper from '../../components/EmbedWrapper.tsx';
import { HEADLINE } from '../../lib/budget-year';

const data = HEADLINE.views.budgetChanges;
---

<Embed title="Biggest budget increases" description={`Top department budget increases, ${HEADLINE.comparisonLabel}.`}>
  <EmbedWrapper title={`Biggest budget increases, ${HEADLINE.comparisonLabel}`} client:load>
    <ChangesChart
      client:load
      data={data.topIncreases}
      title=""
      color="#16a34a"
    />
  </EmbedWrapper>
</Embed>
