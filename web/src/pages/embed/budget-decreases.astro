---
/**Embeddable chart: biggest budget decreases.*/
import Embed from '../../layouts/Embed.astro';
import ChangesChart from '../../components/ChangesChart.tsx';
import EmbedWrapper from '../../components/EmbedWrapper.tsx';
import { HEADLINE } from '../../lib/budget-year';

const data = HEADLINE.views.budgetChanges;
---

<Embed title="Biggest Budget Decreases" description={`Top department budget decreases, ${HEADLINE.comparisonLabel}.`}>
  <EmbedWrapper title={`Biggest Budget Decreases, ${HEADLINE.comparisonLabel}`} client:load>
    <ChangesChart
      client:load
      data={data.topDecreases}
      title=""
      color="#dc2626"
    />
  </EmbedWrapper>
</Embed>
