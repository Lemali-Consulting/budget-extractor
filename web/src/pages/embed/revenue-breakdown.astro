---
/**Embeddable chart: revenue breakdown waterfall.*/
import Embed from '../../layouts/Embed.astro';
import WaterfallChart from '../../components/WaterfallChart.tsx';
import EmbedWrapper from '../../components/EmbedWrapper.tsx';
import { HEADLINE } from '../../lib/budget-year';

const revenueWaterfall = HEADLINE.views.revenueWaterfall;
---

<Embed title="Revenue breakdown" description={`${HEADLINE.fiscalLabel} Pittsburgh revenue sources waterfall chart.`}>
  <EmbedWrapper client:load>
    <WaterfallChart data={revenueWaterfall} yearLabel={HEADLINE.label} client:load />
  </EmbedWrapper>
</Embed>
