---
/**Embeddable chart: where the money goes by department.*/
import Embed from '../../layouts/Embed.astro';
import SpendingPieChart from '../../components/SpendingPieChart.tsx';
import EmbedWrapper from '../../components/EmbedWrapper.tsx';
import { HEADLINE } from '../../lib/budget-year';
import { operating } from '../../lib/department-budgets';

const operatingBudgets = operating(HEADLINE.views.departmentBudgets);
---

<Embed title="Where the money goes" description={`${HEADLINE.fiscalLabel} Pittsburgh budget breakdown by department.`}>
  <EmbedWrapper title={`Where the money goes, ${HEADLINE.fiscalLabel}`} client:load>
    <SpendingPieChart data={operatingBudgets} budgetColumn={HEADLINE.columns.budget} client:load />
  </EmbedWrapper>
</Embed>
