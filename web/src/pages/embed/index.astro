---
/**Index of all embeddable charts with preview and embed snippets.*/
import Base from '../../layouts/Base.astro';
import { HEADLINE } from '../../lib/budget-year';

const SITE_URL = 'https://pgh-budget-explorer.netlify.app';

const embeds = [
  { path: '/embed/budget-increases/', title: 'Biggest Budget Increases', description: `Top department budget increases, ${HEADLINE.comparisonLabel}`, width: 700, height: 500 },
  { path: '/embed/budget-decreases/', title: 'Biggest Budget Decreases', description: `Top department budget decreases, ${HEADLINE.comparisonLabel}`, width: 700, height: 400 },
  { path: '/embed/revenue-breakdown/', title: 'Revenue Breakdown', description: 'How city revenue builds up from component sources', width: 700, height: 500 },
  { path: '/embed/department-comparison/', title: 'Department Comparison', description: 'Top 15 departments by budget total', width: 700, height: 550 },
  { path: '/embed/capital-funding/', title: 'Capital Funding Sources', description: `Capital budget funding by source, ${HEADLINE.fiscalLabel} plan`, width: 700, height: 450 },
  { path: '/embed/spending-breakdown/', title: 'Where the Money Goes', description: 'Operating budget breakdown by department', width: 700, height: 500 },
  { path: '/embed/personnel-changes/', title: 'Staffing Changes', description: `FTE changes by department, ${HEADLINE.comparisonLabel}`, width: 700, height: 450 },
];
---

<Base title="Embeddable Charts" description="Embeddable budget charts for journalists and publishers.">
  <h1 class="text-3xl font-bold mb-2">Embeddable Charts</h1>
  <p class="text-gray-600 mb-6">
    Use these charts in your articles or presentations. Each chart is a standalone page you can embed via iframe.
    Click "Copy embed code" to get a ready-to-paste HTML snippet.
  </p>

  <div class="grid gap-6">
    {embeds.map(embed => {
      const snippet = `<iframe src="${SITE_URL}${embed.path}" width="${embed.width}" height="${embed.height}" frameborder="0" style="border: 1px solid #e5e7eb; border-radius: 8px;" title="${embed.title}"></iframe>`;
      return (
        <div class="bg-white rounded-lg border p-5">
          <div class="flex items-start justify-between mb-3">
            <div>
              <h2 class="text-lg font-semibold">{embed.title}</h2>
              <p class="text-sm text-gray-500">{embed.description}</p>
            </div>
            <a
              href={embed.path}
              target="_blank"
              rel="noopener"
              class="text-sm text-ps-blue-600 hover:text-ps-blue-800 whitespace-nowrap ml-4"
            >
              Preview &rarr;
            </a>
          </div>
          <div class="bg-gray-50 border rounded p-3">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-medium text-gray-500 uppercase tracking-wide">Embed code</span>
              <button
                onclick={`navigator.clipboard.writeText(this.closest('.bg-gray-50').querySelector('code').textContent);this.textContent='Copied!';setTimeout(()=>this.textContent='Copy',2000)`}
                class="text-xs bg-ps-blue-600 text-white rounded px-2 py-1 hover:bg-ps-blue-700 cursor-pointer"
              >
                Copy
              </button>
            </div>
            <code class="text-xs font-mono text-gray-700 break-all block">{snippet}</code>
          </div>
        </div>
      );
    })}
  </div>
</Base>
