---
/**Embeddable chart: capital funding sources by year.*/
import Embed from '../../layouts/Embed.astro';
import FundingSourceChart from '../../components/FundingSourceChart.tsx';
import EmbedWrapper from '../../components/EmbedWrapper.tsx';
import { HEADLINE } from '../../lib/budget-year';

const capitalFunding = HEADLINE.views.capitalFundingSources;
---

<Embed title="Capital Funding Sources" description={`Pittsburgh capital budget funding by source, ${HEADLINE.fiscalLabel}.`}>
  <EmbedWrapper client:load>
    <FundingSourceChart data={capitalFunding} client:load />
  </EmbedWrapper>
</Embed>
