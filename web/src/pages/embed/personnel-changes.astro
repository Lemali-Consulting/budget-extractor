---
/**Embeddable chart: FTE changes by department.*/
import Embed from '../../layouts/Embed.astro';
import PersonnelChangesChart from '../../components/PersonnelChangesChart.tsx';
import EmbedWrapper from '../../components/EmbedWrapper.tsx';
import { HEADLINE } from '../../lib/budget-year';

const personnelByDept = HEADLINE.views.personnelByDepartment;
---

<Embed title="Staffing changes" description={`FTE changes by department, ${HEADLINE.comparisonLabel}.`}>
  <EmbedWrapper title={`Staffing changes by department, ${HEADLINE.comparisonLabel}`} client:load>
    <PersonnelChangesChart data={personnelByDept} year={HEADLINE.year} priorYear={HEADLINE.priorYear} client:load />
  </EmbedWrapper>
</Embed>
