---
/**Embeddable chart: top departments by budget.*/
import Embed from '../../layouts/Embed.astro';
import BudgetChart from '../../components/BudgetChart.tsx';
import EmbedWrapper from '../../components/EmbedWrapper.tsx';
import departmentBudgets from '../../data/views/department-budgets.json';
import { operating, type DeptBudgetRow } from '../../lib/department-budgets';

const operatingBudgets = operating(departmentBudgets as DeptBudgetRow[]);
---

<Embed title="Department Comparison" description="Top Pittsburgh departments by budget, FY2026.">
  <EmbedWrapper title="Top Departments by Budget" client:load>
    <BudgetChart data={operatingBudgets} client:load />
  </EmbedWrapper>
</Embed>
