---
/**Embeddable chart: top departments by budget.*/
import Embed from '../../layouts/Embed.astro';
import BudgetChart from '../../components/BudgetChart.tsx';
import EmbedWrapper from '../../components/EmbedWrapper.tsx';
import { HEADLINE } from '../../lib/budget-year';
import { operating } from '../../lib/department-budgets';

const operatingBudgets = operating(HEADLINE.views.departmentBudgets);
---

<Embed title="Department Comparison" description={`Top Pittsburgh departments by budget, ${HEADLINE.fiscalLabel}.`}>
  <EmbedWrapper title="Top Departments by Budget" client:load>
    <BudgetChart data={operatingBudgets} client:load />
  </EmbedWrapper>
</Embed>
