---
/**
 * At-a-glance metrics card for a budget section page.
 * Only renders if at least one metric is available.
 */

import Sparkline from './Sparkline.tsx';
import type { BudgetYear } from '../lib/budget-year';

interface Props {
  budgetYear: BudgetYear;
  /** Current-year budget total, formatted as in the source table. */
  budget?: string;
  budgetChange?: string;
  budgetChangePct?: string;
  fte?: number;
  tableCount: number;
  pageCount: number;
  sparklineValues?: number[];
}

const {
  budgetYear, budget, budgetChange, budgetChangePct,
  fte, tableCount, pageCount, sparklineValues,
} = Astro.props;

const hasBudget = !!budget;
const hasFte = fte != null;
const hasMetrics = hasBudget || hasFte;

// Determine if change is negative for color coding
const isNegativeChange = budgetChange?.startsWith('(') || budgetChange?.startsWith('-');
const changeColor = isNegativeChange ? 'text-ps-red-600' : 'text-green-600';

---

{hasMetrics && (
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6 p-4 bg-white rounded-lg border">
    {hasBudget && (
      <div>
        <div class="text-xs text-gray-500 mb-1">{budgetYear.shortLabel}</div>
        <div class="text-lg font-semibold text-gray-900 flex items-center gap-2">
          ${budget}
          {sparklineValues && sparklineValues.length >= 2 && (
            <Sparkline values={sparklineValues} width={72} height={24} />
          )}
        </div>
      </div>
    )}
    {hasBudget && budgetChange && budgetChange !== '—' && (
      <div>
        <div class="text-xs text-gray-500 mb-1">vs {budgetYear.priorLabel}</div>
        <div class={`text-lg font-semibold ${changeColor}`}>
          <span aria-hidden="true">{isNegativeChange ? '↓' : '↑'}</span>{' '}
          {isNegativeChange ? '-' : '+'}{budgetChange.replace(/[()]/g, '')}
          {budgetChangePct && <span class="text-sm ml-1">({budgetChangePct.replace(/[()]/g, '')})</span>}
        </div>
      </div>
    )}
    {hasFte && (
      <div>
        <div class="text-xs text-gray-500 mb-1">Positions (<a href="/glossary/#abbreviations" class="glossary-term" data-tooltip="Full-time equivalent — 1.0 = one full-time position. Part-time roles are fractions (e.g., 0.5 = half-time).">FTE</a>)</div>
        <div class="text-lg font-semibold text-gray-900">
          {fte?.toLocaleString()}
        </div>
      </div>
    )}
    <div>
      <div class="text-xs text-gray-500 mb-1">Content</div>
      <div class="text-lg font-semibold text-gray-900">
        {`${tableCount} ${tableCount === 1 ? 'table' : 'tables'}`}
        <span class="text-sm text-gray-500 ml-1">{`· ${pageCount} pg`}</span>
      </div>
    </div>
  </div>
)}
