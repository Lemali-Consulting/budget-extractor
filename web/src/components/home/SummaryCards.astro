---
/**
 * The home page's five summary cards: operating budget, trust funds,
 * projected revenue, capital and personnel. Also shown alone at
 * /embed/budget-summary/.
 */
import PersonnelCard from '../PersonnelCard.astro';
import { HEADLINE } from '../../lib/budget-year';
import { correctionHref, trustFundCorrections } from '../../lib/corrections';
import {
  capitalPlanTotal,
  capitalYearTotal,
  fmtM,
  operatingChangePct,
  operatingTotal,
  revenueSources,
  revenueTotal,
  trustFundTotal,
} from '../../lib/headline-figures';

interface Props {
  /** Spacing around the cards, set by the page placing them. */
  class?: string;
}

const { class: className = '' } = Astro.props;
// Trust-fund figures in the headline year that rest on one of our corrections to the source PDF.
const trustCorrections = trustFundCorrections({
  corrections: HEADLINE.corrections,
  departmentBudgets: HEADLINE.views.departmentBudgets,
  budgetColumn: HEADLINE.columns.budget,
});
---

<div class={`grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 ${className}`} data-testid="summary-cards">
  <div class="bg-white rounded-lg border p-4">
    <div class="text-xs text-gray-400">Operating budget</div>
    <div class="text-2xl font-bold text-ps-blue-900 mt-1">{fmtM(operatingTotal)}</div>
    <div class={`text-sm mt-0.5 ${operatingChangePct >= 0 ? 'text-ps-blue-600' : 'text-ps-red-600'}`}>
      {operatingChangePct >= 0 ? '+' : ''}{operatingChangePct.toFixed(1)}% vs {HEADLINE.priorYear}
    </div>
  </div>
  <div class="bg-white rounded-lg border p-4" data-testid="trust-fund-total">
    <div class="text-xs text-gray-400">Trust funds{trustCorrections.length > 0 && <span aria-hidden="true"> &dagger;</span>}</div>
    <div class="text-2xl font-bold text-slate-700 mt-1" data-testid="trust-fund-total-amount">{fmtM(trustFundTotal)}</div>
    <div class="text-sm text-gray-500 mt-0.5">Separate from operating</div>
    <a href="/trust-funds/" class="block text-xs text-ps-blue-600 hover:underline mt-1">See the funds &rarr;</a>
    {trustCorrections.length > 0 && (
      <a
        href={correctionHref({ year: HEADLINE.year, id: trustCorrections[0].id })}
        class="block text-xs text-ps-yellow-800 underline hover:text-ps-yellow-600 mt-1"
        data-testid="trust-fund-correction-footnote"
      >
        &dagger; Includes a heading correction by us ({trustCorrections.map((c) => c.section).join(', ')}): the PDF mislabels its years. Details
      </a>
    )}
  </div>
  <div class="bg-white rounded-lg border p-4">
    <div class="text-xs text-gray-400">Projected revenue</div>
    <div class="text-2xl font-bold text-green-900 mt-1">{fmtM(revenueTotal)}</div>
    <div class="text-sm text-gray-500 mt-0.5">{revenueSources.length} sources</div>
  </div>
  <div class="bg-white rounded-lg border p-4">
    <div class="text-xs text-gray-400">Capital ({HEADLINE.year})</div>
    <div class="text-2xl font-bold text-ps-yellow-900 mt-1">{fmtM(capitalYearTotal)}</div>
    <div class="text-sm text-gray-500 mt-0.5">6-yr plan: {fmtM(capitalPlanTotal)}</div>
  </div>
  <PersonnelCard budgetYear={HEADLINE} />
</div>
