---
import Base from '../../layouts/Base.astro';
import { pagefindBodyAttrs, PAGEFIND_BUDGET_TYPE } from '../../lib/pagefind';
import TableViewer from '../TableViewer.astro';
import PageImage from '../PageImage.tsx';
import ChartImage from '../ChartImage.tsx';
import PdfSidebar from '../PdfSidebar.tsx';
import SectionNav from '../SectionNav.astro';
import CapitalAppendices from '../CapitalAppendices.tsx';
import { type BudgetYear, HEADLINE, headlinePath } from '../../lib/budget-year';
import { chartImageUrl } from '../../lib/image-paths';
import { buildGlossaryTerms, createGlossaryLinker } from '../../utils/glossary-linker';

interface Props {
  budgetYear: BudgetYear;
  section: any;
  prev: { slug: string; title: string } | null;
  next: { slug: string; title: string } | null;
}

const { budgetYear, section, prev, next } = Astro.props as Props;
const meta = section as any;
const prefix = budgetYear.routePrefix;
const indexAttrs = pagefindBodyAttrs({ isHeadline: budgetYear.isHeadline, budgetType: PAGEFIND_BUDGET_TYPE.CAPITAL });
const appendicesData = budgetYear.capitalAppendices;

// Same project in the current version, when the headline capital budget has it.
const headlineHasProject = HEADLINE.capital.sections.some((s: any) => s.slug === section.slug);
const currentHref = headlineHasProject ? headlinePath(`/capital/${section.slug}/`) : headlinePath('/capital/');

const glossaryTerms = buildGlossaryTerms(budgetYear.operating.glossary || {});
const linkGlossaryTerms = createGlossaryLinker(glossaryTerms);
const pageCount = section.start_page && section.end_page
  ? section.end_page - section.start_page + 1
  : 0;

// Build a unified page-ordered stream of content items
type ContentItem =
  | { kind: 'table'; page: number; sortKey: number; data: any }
  | { kind: 'narrative'; page: number; sortKey: number; text: string; role: string }
  | { kind: 'chart'; page: number; sortKey: number; chartType: string; chartIndex: number }
  | { kind: 'page_break'; page: number; sortKey: number; absolutePage: number };

const items: ContentItem[] = [];

// Add tables
for (const table of section.tables) {
  items.push({ kind: 'table', page: table.relative_page, sortKey: 500, data: table });
}

// Add page content (narrative blocks)
const pageContent = (section as any).page_content || [];
for (const pc of pageContent) {
  const relPage = pc.relative_page;
  for (const block of pc.text_blocks || []) {
    const y = block.bbox?.[1] ?? 0;
    items.push({ kind: 'narrative', page: relPage, sortKey: y, text: block.text, role: block.role });
  }
  (pc.chart_regions || []).forEach((chart: any, ci: number) => {
    const y = chart.bbox?.[1] ?? 0;
    items.push({ kind: 'chart', page: relPage, sortKey: y, chartType: chart.chart_type, chartIndex: ci });
  });
}

// Sort by page, then by y-position within page
items.sort((a, b) => a.page - b.page || a.sortKey - b.sortKey);

// Insert page breaks between pages
const finalItems: ContentItem[] = [];
let lastPage = -1;
for (const item of items) {
  if (item.page !== lastPage) {
    const absPage = section.start_page ? section.start_page + item.page : item.page;
    finalItems.push({ kind: 'page_break', page: item.page, sortKey: -1, absolutePage: absPage });
    lastPage = item.page;
  }
  finalItems.push(item);
}

const hasNarrative = finalItems.some(i => i.kind === 'narrative');

// Parse narrative text into structured segments for rendering
type Segment =
  | { type: 'heading'; text: string }
  | { type: 'paragraph'; text: string }
  | { type: 'bullets'; items: string[] };

function parseNarrative(raw: string): Segment[] {
  const lines = raw.split('\n');
  const segments: Segment[] = [];
  let pendingProse: string[] = [];
  let pendingBullets: string[] = [];

  function flushProse() {
    if (pendingProse.length > 0) {
      segments.push({ type: 'paragraph', text: pendingProse.join(' ') });
      pendingProse = [];
    }
  }
  function flushBullets() {
    if (pendingBullets.length > 0) {
      segments.push({ type: 'bullets', items: [...pendingBullets] });
      pendingBullets = [];
    }
  }

  // Known capital project section headings
  const knownHeadings = new Set([
    'project description',
    'project justification',
    'operating budget impact',
    'unexpended/unencumbered prior year funds',
  ]);

  for (let i = 0; i < lines.length; i++) {
    const line = lines[i].trim();
    if (!line) { flushProse(); flushBullets(); continue; }

    const isBullet = /^[•◦●▪–-]\s/.test(line) || /^\d+\.\s/.test(line);

    if (isBullet) {
      flushProse();
      pendingBullets.push(line);
    } else if (pendingBullets.length > 0) {
      pendingBullets[pendingBullets.length - 1] += ' ' + line;
    } else if (knownHeadings.has(line.toLowerCase())) {
      flushProse();
      flushBullets();
      segments.push({ type: 'heading', text: line });
    } else {
      flushBullets();
      pendingProse.push(line);
    }
  }
  flushProse();
  flushBullets();
  return segments;
}

---

<Base title={section.title} budgetYear={budgetYear} currentHref={currentHref}>
  <div {...indexAttrs}>
  <nav class="text-sm text-gray-500 mb-4" data-pagefind-ignore>
    <a href="/" class="hover:text-blue-600">Home</a>
    <span class="mx-1" aria-hidden="true">/</span>
    <a href={`${prefix}/capital/`} class="hover:text-blue-600">Capital Budget</a>
    <span class="mx-1" aria-hidden="true">/</span>
    <span>{section.title}</span>
  </nav>

  <div data-pagefind-ignore><SectionNav prev={prev} next={next} basePath={`${prefix}/capital`} position="top" /></div>

  <h1 class="text-3xl font-bold mb-2">{section.title}</h1>

  {(meta.functional_area || meta.department) && (
    <div class="flex flex-wrap gap-3 text-sm text-gray-600 mb-6">
      {meta.functional_area && (
        <span class="px-2 py-0.5 bg-blue-50 text-blue-700 rounded">{meta.functional_area}</span>
      )}
      {meta.department && (
        <span class="px-2 py-0.5 bg-gray-100 text-gray-700 rounded">{meta.department}</span>
      )}
      {meta.project_type && (
        <span class="px-2 py-0.5 bg-green-50 text-green-700 rounded">{meta.project_type}</span>
      )}
      {meta.project_manager && (
        <span class="text-gray-500">PM: {meta.project_manager}</span>
      )}
    </div>
  )}

  <p class="text-gray-500 mb-6">
    {section.start_page && section.end_page ? `Pages ${section.start_page}–${section.end_page} in Capital Budget` : ''}
    {section.slug !== 'capital-budget-appendices' && (
      <>
        · {section.tables.length} {section.tables.length === 1 ? 'table' : 'tables'}
        {hasNarrative ? ' · includes narrative' : ''}
      </>
    )}
  </p>

  {section.slug === 'capital-budget-appendices' ? (
    <CapitalAppendices client:load data={appendicesData as any} year={budgetYear.year} />
  ) : finalItems.length === 0 ? (
    <p class="text-gray-400 italic">No content extracted for this project.</p>
  ) : finalItems.map((item) => {
    if (item.kind === 'page_break') {
      return (
        <div id={`page-${item.page}`} class="flex items-center gap-3 my-6 text-xs text-gray-400" data-page-marker={item.page} data-pagefind-ignore>
          <div class="flex-1 border-t border-gray-200"></div>
          <span class="flex items-center gap-2">
            Page {(item as any).absolutePage}
            <PageImage client:load year={budgetYear.year} slug={section.slug} page={item.page} label="View image" />
          </span>
          <div class="flex-1 border-t border-gray-200"></div>
        </div>
      );
    }

    if (item.kind === 'narrative') {
      const isTitle = item.role === 'section_title';
      const isFootnote = item.role === 'footnote';
      if (isTitle) {
        const titleHtml = linkGlossaryTerms(item.text.replace(/\n/g, ' '));
        return <h2 class="text-xl font-semibold text-gray-800 mt-6 mb-2" set:html={titleHtml} />;
      }
      if (isFootnote) {
        const fnHtml = linkGlossaryTerms(item.text.replace(/\n/g, ' '));
        return <p class="text-xs text-gray-400 mt-1 mb-0" set:html={fnHtml} />;
      }
      const segments = parseNarrative(item.text);
      return (
        <div class="prose prose-sm max-w-3xl mb-4 text-gray-700 leading-relaxed">
          {segments.map((seg) => {
            if (seg.type === 'heading') {
              const hHtml = linkGlossaryTerms(seg.text);
              return <h3 class="text-base font-semibold text-gray-800 mt-4 mb-1" set:html={hHtml} />;
            }
            if (seg.type === 'bullets') {
              return (
                <ul class="list-disc list-inside ml-2 mb-2 space-y-0.5">
                  {seg.items.map((b) => {
                    const cleaned = b.replace(/^[•◦●▪–-]\s*/, '').replace(/^\d+\.\s*/, '');
                    const liHtml = linkGlossaryTerms(cleaned);
                    return <li set:html={liHtml} />;
                  })}
                </ul>
              );
            }
            const pHtml = linkGlossaryTerms(seg.text);
            return <p class="mb-2" set:html={pHtml} />;
          })}
        </div>
      );
    }

    if (item.kind === 'chart') {
      const chartSrc = chartImageUrl({ year: budgetYear.year, slug: section.slug, page: item.page, chartIndex: (item as any).chartIndex });
      const cType = (item as any).chartType;
      const isLogo = cType === 'logo';
      const label = isLogo ? 'Department seal' : cType === 'raster_image' ? 'Figure' : 'Chart / diagram';
      if (isLogo) {
        return (
          <div class="my-3 flex items-center gap-3">
            <img
              src={chartSrc}
              alt={`${label} for ${section.title}`}
              class="w-16 h-16 object-contain"
              loading="lazy"
            />
            <span class="text-xs text-gray-400">{section.title}</span>
          </div>
        );
      }
      return (
        <ChartImage
          client:visible
          src={chartSrc}
          alt={`${label} for ${section.title}`}
          label={label}
        />
      );
    }

    if (item.kind === 'table') {
      return <TableViewer year={budgetYear.year} table={(item as any).data} linkCell={linkGlossaryTerms} />;
    }
  })}

  <div data-pagefind-ignore><SectionNav prev={prev} next={next} basePath={`${prefix}/capital`} /></div>

  <div data-pagefind-ignore>
  {section.start_page && section.end_page && pageCount > 0 && (
    <PdfSidebar
      client:load
      year={budgetYear.year}
      slug={section.slug}
      totalPages={pageCount}
      startPage={section.start_page}
    />
  )}
  </div>
  </div>
</Base>
