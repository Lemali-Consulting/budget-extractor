---
import Base from '../../layouts/Base.astro';
import PersonnelExplorer from '../PersonnelExplorer.tsx';
import PersonnelTreemap from '../PersonnelTreemap.tsx';
import { type BudgetYear, headlinePath } from '../../lib/budget-year';
import { DEPARTMENT_SALARY_SCOPE, type DepartmentPersonnel } from '../../lib/personnel';

interface Props {
  budgetYear: BudgetYear;
}

const { budgetYear } = Astro.props as Props;
const prefix = budgetYear.routePrefix;
const personnelData = budgetYear.views.personnel;
const personnelByDept = budgetYear.views.personnelByDepartment;
const salaries = budgetYear.views.salariesAndWages;
const departmentSalaryTotal = (personnelByDept as DepartmentPersonnel[]).reduce((sum, d) => sum + d.totalBudgetCurrent, 0);

function fmtDollar(n: number): string {
  if (n >= 1_000_000) return `$${(n / 1_000_000).toFixed(1)}M`;
  if (n >= 1_000) return `$${(n / 1_000).toFixed(0)}K`;
  return `$${n.toFixed(0)}`;
}
---

<Base title="Personnel" budgetYear={budgetYear} currentHref={headlinePath('/personnel/')}>
  <nav class="text-sm text-gray-500 mb-4">
    <a href="/" class="hover:text-ps-blue-600">Home</a>
    <span class="mx-1" aria-hidden="true">/</span>
    <span>Personnel</span>
  </nav>

  <h1 class="text-3xl font-bold mb-2">Personnel explorer</h1>
  <p class="text-gray-600 mb-2">Search and filter positions across all departments.</p>
  <p class="text-sm text-gray-500 mb-6 max-w-3xl" data-testid="personnel-scope-note">
    Salary figures here come from each department's position table: {DEPARTMENT_SALARY_SCOPE.toLowerCase()}, trust funds included.
    Together they come to {fmtDollar(departmentSalaryTotal)}.
    {salaries ? (
      <>That is less than the {fmtDollar(salaries.current)} General Fund salaries-and-wages line on{' '}
      <a href={`${prefix}/sections/${salaries.sectionSlug}/`} class="text-ps-blue-600 hover:underline">page {salaries.page}</a>,
      because overtime and other premium pay are budgeted only citywide, not by position.</>
    ) : (
      <>Overtime and other premium pay are budgeted only citywide, so they are not included.</>
    )}
  </p>

  <PersonnelTreemap data={personnelByDept} routePrefix={prefix} client:load />

  <PersonnelExplorer rows={personnelData} year={budgetYear.year} routePrefix={prefix} client:load />
</Base>
