---
/**
 * Per-fund breakdown of the trust-fund total shown on the home page and dashboard.
 * The budget document has no combined trust-fund line, so this page is how a
 * reader checks our sum against each fund's own page in the PDF.
 */
import Base from '../../layouts/Base.astro';
import { type BudgetYear, headlinePath } from '../../lib/budget-year';
import { trustFundBreakdown } from '../../lib/department-budgets';
import { correctionHref, trustFundCorrections } from '../../lib/corrections';

interface Props {
  budgetYear: BudgetYear;
}

const { budgetYear } = Astro.props as Props;
const prefix = budgetYear.routePrefix;
const { columns } = budgetYear;
const budgetRows = budgetYear.views.departmentBudgets;
const { funds, unfunded, total } = trustFundBreakdown(budgetRows, columns);

const sectionsBySlug = new Map<string, any>(budgetYear.operating.sections.map((s: any) => [s.slug, s]));
const correctionsBySlug = new Map(
  trustFundCorrections({ corrections: budgetYear.corrections, departmentBudgets: budgetRows, budgetColumn: columns.budget })
    .map((c) => [c.sectionSlug, c]),
);
const firstPage = Math.min(...funds.map((f) => sectionsBySlug.get(f.slug)?.start_page ?? Infinity));

function pages(slug: string): string {
  const s = sectionsBySlug.get(slug);
  if (!s?.start_page) return '';
  return s.end_page && s.end_page !== s.start_page ? `pp. ${s.start_page}–${s.end_page}` : `p. ${s.start_page}`;
}

function fmtDollar(n: number | null): string {
  return n === null ? '—' : `$${Math.round(n).toLocaleString('en-US')}`;
}

function fmtM(n: number): string {
  return `$${(n / 1_000_000).toFixed(1)}M`;
}

function fmtChange(f: { current: number | null; prior: number | null }): string {
  if (f.current === null || f.prior === null || f.prior === 0) return '—';
  const pct = ((f.current - f.prior) / f.prior) * 100;
  const shown = pct.toFixed(1);
  if (Number(shown) === 0) return '0.0%';
  return `${pct > 0 ? '+' : ''}${shown}%`;
}
---

<Base title="Trust Funds" budgetYear={budgetYear} currentHref={headlinePath('/trust-funds/')}>
  <nav class="text-sm text-gray-500 mb-4">
    <a href="/" class="hover:text-ps-blue-600">Home</a>
    <span class="mx-1" aria-hidden="true">/</span>
    <a href={`${prefix}/operating/`} class="hover:text-ps-blue-600">Operating Budget</a>
    <span class="mx-1" aria-hidden="true">/</span>
    <span>Trust Funds</span>
  </nav>

  <h1 class="text-3xl font-bold mb-2">Trust Funds</h1>
  <p class="text-gray-600 mb-2 max-w-3xl">
    The budget document calls these special revenue funds: money whose use is restricted or committed to a specific purpose,
    kept separate from the General Fund that pays for day-to-day operations. Despite the word "trust" in most of their names,
    no trustee holds the money. The {budgetYear.fiscalLabel} operating budget document gives <span data-testid="trust-fund-count">{funds.length}</span> of them
    a {budgetYear.year} budget{Number.isFinite(firstPage) && <>, starting on page {firstPage}</>}.
  </p>
  <p class="text-gray-600 mb-6 max-w-3xl">
    The document doesn't print a combined total. The {fmtM(total)} on our home page is the sum of the {budgetYear.year} budgets below.
  </p>

  <div class="overflow-x-auto bg-white rounded-lg border mb-6">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 text-gray-600">
        <tr>
          <th scope="col" class="text-left font-medium px-3 py-2">Fund</th>
          <th scope="col" class="hidden sm:table-cell text-right font-medium px-3 py-2">{columns.priorBudget}</th>
          <th scope="col" class="text-right font-medium px-3 py-2">{columns.budget}</th>
          <th scope="col" class="hidden sm:table-cell text-right font-medium px-3 py-2">Change</th>
          <th scope="col" class="text-left font-medium px-3 py-2">In the PDF</th>
        </tr>
      </thead>
      <tbody>
        {funds.map((f) => {
          const correction = correctionsBySlug.get(f.slug);
          return (
            <tr class="border-t" data-testid="trust-fund-row">
              <td class="px-3 py-2">
                <a href={`${prefix}/sections/${f.slug}/`} class="text-ps-blue-600 hover:underline">{f.department}</a>
                {correction && (
                  <a href={correctionHref({ year: budgetYear.year, id: correction.id })} class="ml-1 text-xs text-ps-yellow-800 underline">
                    Corrected by us
                  </a>
                )}
              </td>
              <td class="hidden sm:table-cell px-3 py-2 text-right tabular-nums text-gray-500">{fmtDollar(f.prior)}</td>
              <td class="px-3 py-2 text-right tabular-nums">{fmtDollar(f.current)}</td>
              <td class="hidden sm:table-cell px-3 py-2 text-right tabular-nums text-gray-500">{fmtChange(f)}</td>
              <td class="px-3 py-2 text-gray-500 sm:whitespace-nowrap">{pages(f.slug)}</td>
            </tr>
          );
        })}
      </tbody>
      <tfoot>
        <tr class="border-t-2 font-semibold">
          <th scope="row" class="text-left px-3 py-2">Total ({funds.length} funds)</th>
          <td class="hidden sm:table-cell px-3 py-2"></td>
          <td class="px-3 py-2 text-right tabular-nums">
            {fmtDollar(total)}
            <span class="block text-xs font-normal text-gray-500" data-testid="trust-fund-sum">{fmtM(total)}</span>
          </td>
          <td class="hidden sm:table-cell px-3 py-2"></td>
          <td class="px-3 py-2"></td>
        </tr>
      </tfoot>
    </table>
  </div>

  {unfunded.length > 0 && (
    <div class="max-w-3xl text-sm text-gray-600">
      <h2 class="font-semibold text-gray-700 mb-1">Funds with no {budgetYear.year} budget</h2>
      <p class="mb-2">These had a {budgetYear.priorYear} budget but none for {budgetYear.year}, so they add nothing to the total.</p>
      <ul class="list-disc pl-5">
        {unfunded.map((f) => (
          <li>
            <a href={`${prefix}/sections/${f.slug}/`} class="text-ps-blue-600 hover:underline">{f.department}</a>: {fmtDollar(f.prior)} in {budgetYear.priorYear}{pages(f.slug) && <> ({pages(f.slug)})</>}
          </li>
        ))}
      </ul>
    </div>
  )}
</Base>
