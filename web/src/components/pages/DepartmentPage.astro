---
/**Department one-pager — simplified, print-friendly department summary (archive years; the headline merges it into the section page).*/
import Base from '../../layouts/Base.astro';
import DepartmentSummary from '../DepartmentSummary.astro';
import { type BudgetYear, HEADLINE, headlinePath } from '../../lib/budget-year';

interface Props {
  budgetYear: BudgetYear;
  slug: string;
}

const { budgetYear, slug } = Astro.props as Props;
const prefix = budgetYear.routePrefix;
const budgets = budgetYear.views.departmentBudgets;
const section = budgetYear.operating.sections.find((s: any) => s.slug === slug);

// Same department in the current version, when the headline budget has one.
const headlineHasDepartment = HEADLINE.views.departmentBudgets.some(
  (r) => r.slug === slug && r.year === HEADLINE.columns.budget,
);
const currentHref = headlineHasDepartment ? headlinePath(`/departments/${slug}/`) : headlinePath('/departments/');

const deptChange = budgetYear.views.budgetChanges.departmentChanges.find((d: any) => d.slug === slug);
const deptName = deptChange?.department || budgets.find(b => b.slug === slug)?.department || slug;

// Extract narrative text (first narrative block from section)
let narrative = '';
if (section?.page_content) {
  for (const page of section.page_content) {
    for (const block of page.text_blocks || []) {
      if (block.role === 'narrative' && block.text.length > 50) {
        narrative = block.text.split('\n').slice(0, 3).join(' ');
        break;
      }
    }
    if (narrative) break;
  }
}
---

<Base title={deptName} description={`One-page summary of ${deptName} — ${budgetYear.fiscalLabel} budget, staffing, and spending.`} budgetYear={budgetYear} currentHref={currentHref}>
  <div class="max-w-3xl mx-auto print:max-w-none">
    <!-- Header -->
    <div class="mb-6 print:mb-4">
      <nav class="text-sm text-gray-500 mb-2 print:hidden">
        <a href={`${prefix}/departments/`} class="hover:text-ps-blue-600">Departments</a>
        <span class="mx-1">/</span>
        <span>{deptName}</span>
      </nav>
      <h1 class="text-3xl font-bold print:text-2xl">{deptName}</h1>
      {narrative && (
        <p class="text-gray-600 mt-2 leading-relaxed">{narrative}</p>
      )}
    </div>

    <DepartmentSummary budgetYear={budgetYear} slug={slug} />

    <!-- Actions -->
    <div class="flex items-center gap-4 text-sm print:hidden">
      <a href={`${prefix}/sections/${slug}/`} class="text-ps-blue-600 hover:underline">View full department detail &rarr;</a>
      <button onclick="window.print()" class="text-gray-500 hover:text-gray-700 flex items-center gap-1 cursor-pointer">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
        Print / Save as PDF
      </button>
    </div>
  </div>
</Base>
