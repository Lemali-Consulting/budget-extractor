---
interface Props {
  table: {
    id: string;
    relative_page: number;
    table_index: number;
    table_type: string;
    headers: string[];
    rows: string[][];
    absolute_page?: number;
  };
}

const { table } = Astro.props;

const typeColors: Record<string, string> = {
  personnel: 'bg-purple-100 text-purple-700',
  financial: 'bg-green-100 text-green-700',
  financial_summary: 'bg-emerald-100 text-emerald-700',
  revenue: 'bg-blue-100 text-blue-700',
  unknown: 'bg-gray-100 text-gray-600',
};

const badgeClass = typeColors[table.table_type] || typeColors.unknown;
---

<div class="mb-8 bg-white rounded-lg border overflow-hidden">
  <div class="px-4 py-3 bg-gray-50 border-b flex items-center gap-3 text-sm">
    <span class={`px-2 py-0.5 rounded text-xs font-medium ${badgeClass}`}>
      {table.table_type}
    </span>
    <span class="text-gray-500">
      Page {table.relative_page}, Table {table.table_index}
      {table.absolute_page ? ` (p. ${table.absolute_page} in full PDF)` : ''}
    </span>
  </div>
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      {table.headers.length > 0 && (
        <thead>
          <tr class="bg-gray-50">
            {table.headers.map((h) => (
              <th class="px-3 py-2 text-left font-medium text-gray-700 border-b whitespace-nowrap">
                {h}
              </th>
            ))}
          </tr>
        </thead>
      )}
      <tbody>
        {table.rows.map((row, i) => (
          <tr class={i % 2 === 0 ? 'bg-white' : 'bg-gray-50'}>
            {row.map((cell) => (
              <td class="px-3 py-1.5 border-b border-gray-100 whitespace-nowrap">
                {cell}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>
