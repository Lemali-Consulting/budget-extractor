---
import PageImage from './PageImage.tsx';
import { BUDGET_YEARS, type AmendmentInfo } from '../lib/budget-year';
import { columnHeaderLabel } from '../lib/text-case';
import {
  changedHeaders,
  correctionHref,
  quoteList,
  type CorrectionRef,
  type SourceCorrection,
} from '../lib/corrections';

interface Props {
  /** Budget year the table belongs to (selects the source-page image folder). */
  year: number;
  table: {
    id: string;
    relative_page: number;
    table_index: number;
    table_type: string;
    headers: string[];
    rows: string[][];
    sections?: string[];
    absolute_page?: number;
    description?: string;
    /** Set when we corrected this table's headings; see utils/corrections.py. */
    corrections?: CorrectionRef[];
  };
  slug?: string;
  linkCell?: (text: string) => string;
  inset?: boolean;
  // Per-table adopted-vs-amended diff slice: rowLabel -> columnKey -> values.
  // columnKey is the trimmed header, or the column index when the header is blank.
  amendmentDiffs?: {
    rows: Record<string, Record<string, { adopted: number; amended: number; delta: number; pct: number | null }>>;
  };
  // True when an adopted (pre-amendment) image exists for this table's page,
  // enabling the Amended/Adopted toggle in the source-page lightbox.
  adoptedPageAvailable?: boolean;
  // Amendment labels; passed only on amended years (never on the 2027 headline).
  amendment?: AmendmentInfo | null;
}

const { year, table, slug, linkCell, amendmentDiffs, adoptedPageAvailable, amendment } = Astro.props;
const amendmentDiffsForYear = amendment ? amendmentDiffs : undefined;
const amendmentDates = amendment
  ? { amendedDate: amendment.amendedDate, adoptedDate: amendment.adoptedDate }
  : undefined;

// Full records (printed vs shown headings, PDF page) of the corrections applied to this table.
const tableCorrections: SourceCorrection[] = (table.corrections || [])
  .map((ref) =>
    (BUDGET_YEARS[year]?.corrections || []).find((c) => c.id === ref.id && c.tableId === table.id),
  )
  .filter((c): c is SourceCorrection => c !== undefined);

import { TYPE_COLORS, typeDescription } from '../lib/type-colors';

const badgeClass = TYPE_COLORS[table.table_type] || TYPE_COLORS.unknown;
const annotation = table.description || typeDescription(table.table_type);
const sections = table.sections || [];
const colCount = table.headers.length;

// Detect numeric columns: columns where >50% of non-empty values look numeric/currency
const numericColSet = new Set<number>();
for (let ci = 0; ci < colCount; ci++) {
  let numCount = 0;
  let total = 0;
  for (const row of table.rows) {
    const cell = (row[ci] || '').trim();
    if (!cell) continue;
    total++;
    if (/^[\$\(]?[\d,]+(\.\d+)?[\)]?$/.test(cell) || cell === '—') numCount++;
  }
  if (total > 0 && numCount / total > 0.5) numericColSet.add(ci);
}

// Detect paired year columns for change highlighting
// Maps later-year column index → earlier-year column index
const yearPairs = new Map<number, number>();
const yearPattern = /\b(20\d{2})\b/;
for (let ci = 0; ci < colCount; ci++) {
  const h = table.headers[ci] || '';
  const m = h.match(yearPattern);
  if (!m) continue;
  const year = parseInt(m[1], 10);
  const metric = h.replace(yearPattern, '').trim().toLowerCase();
  // Look for an earlier-year column with the same metric
  for (let cj = 0; cj < ci; cj++) {
    const h2 = table.headers[cj] || '';
    const m2 = h2.match(yearPattern);
    if (!m2) continue;
    const year2 = parseInt(m2[1], 10);
    const metric2 = h2.replace(yearPattern, '').trim().toLowerCase();
    if (metric === metric2 && year > year2) {
      yearPairs.set(ci, cj);
      break;
    }
  }
}

function parseNum(s: string): number | null {
  const t = s.trim();
  if (!t || t === '—' || t === '-') return null;
  const neg = t.startsWith('(') || t.startsWith('-');
  const num = parseFloat(t.replace(/[$,()]/g, ''));
  if (isNaN(num)) return null;
  return neg ? -Math.abs(num) : num;
}

// Pre-compute change classes for each cell: '' | 'increased' | 'decreased'
const cellChangeClass: string[][] = table.rows.map((row) => {
  return row.map((cell, ci) => {
    const pairCol = yearPairs.get(ci);
    if (pairCol === undefined) return '';
    const cur = parseNum(cell);
    const prev = parseNum(row[pairCol] || '');
    if (cur === null || prev === null) return '';
    if (cur > prev) return 'changed-increase';
    if (cur < prev) return 'changed-decrease';
    return '';
  });
});

function isTotalRow(row: string[]): boolean {
  const cell = (row[0] || '').trim().toLowerCase();
  return cell.startsWith('total') || cell.endsWith('total');
}

// Pre-compute per-cell amendment metadata (highlight class + tooltip text),
// keyed by row label + column key to match build_amendment_diff.py output.
function fmtUSD(n: number): string {
  return `$${Math.round(n).toLocaleString('en-US')}`;
}
const amendmentCell: ({ cls: string; tip: string } | null)[][] = table.rows.map((row) => {
  const rowDiffs = amendmentDiffsForYear?.rows?.[(row[0] || '').trim()];
  return row.map((_, ci) => {
    if (!rowDiffs) return null;
    const header = (table.headers[ci] || '').trim();
    const colKey = header || String(ci);
    const d = rowDiffs[colKey];
    if (!d || d.delta === 0) return null;
    const cls = d.delta > 0 ? 'has-amendment-up' : 'has-amendment-down';
    // FTE columns are counts, not dollars — format without a currency symbol.
    const fmt = /fte/i.test(header) ? (n: number) => `${n}` : fmtUSD;
    const pctStr = d.pct === null ? '' : ` (${d.pct >= 0 ? '+' : ''}${d.pct}%)`;
    const sign = d.delta >= 0 ? '+' : '−';
    const tip = `${amendment!.adoptedLabel} ${fmt(d.adopted)} · ${amendment!.amendedLabel} ${fmt(d.amended)} · ${sign}${fmt(Math.abs(d.delta))}${pctStr}`;
    return { cls, tip };
  });
});
---

<div class="mb-8 bg-white rounded-lg border overflow-hidden" id={`table-container-${table.id}`}>
  <div class="px-4 py-3 bg-gray-50 border-b text-sm">
    <div class="flex items-center gap-3">
      <span class={`px-2 py-0.5 rounded text-xs font-medium ${badgeClass}`}>
        {table.table_type}
      </span>
      {tableCorrections.length > 0 && (
        <span
          class="px-2 py-0.5 rounded text-xs font-semibold bg-ps-yellow-100 text-ps-yellow-900 border border-ps-yellow-300"
          data-testid="table-correction-badge"
          title="Column headings relabelled by Pittsburgh Budget Explorer; not what the source PDF prints"
        >
          Corrected by us
        </span>
      )}
      <span class="text-gray-500">
        Page {table.relative_page}, table {table.table_index}
        {table.absolute_page ? ` (p. ${table.absolute_page} in full PDF)` : ''}
      </span>
      {slug && (
        <PageImage client:load year={year} slug={slug} page={table.relative_page} adoptedAvailable={adoptedPageAvailable} amendmentDates={amendmentDates} />
      )}
      <button
        class="ml-auto text-xs text-gray-400 hover:text-ps-blue-600 print:hidden copy-table-btn"
        data-table-id={table.id}
        title="Copy table as tab-separated text"
        aria-label="Copy table"
      >
        Copy table
      </button>
    </div>
    <p class="text-xs text-gray-400 italic mt-1">{annotation}</p>
    {tableCorrections.map((c) => {
      const { printed, shown } = changedHeaders(c);
      return (
        <p class="mt-2 border-l-4 border-ps-yellow-400 bg-ps-yellow-50 rounded-r px-3 py-2 text-xs text-ps-yellow-900" data-testid="table-correction-note">
          <strong>Corrected by Pittsburgh Budget Explorer.</strong>{' '}
          The source PDF (page {c.pdfPage} of the full document) prints this table's headings as {quoteList(printed)}.
          The figures are really the {shown.map((h) => h.replace(/ Budget$/, '')).join(' and ')} budgets, so we show them as {quoteList(shown)}.
          The PDF itself is unchanged.{' '}
          <a href={correctionHref({ year, id: c.id })} class="font-medium underline hover:text-ps-yellow-700">Why we made this correction &rarr;</a>
        </p>
      );
    })}
  </div>
  <div class="table-scroll-wrap relative">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        {table.headers.length > 0 && (
          <thead>
            <tr class="bg-gray-50">
              {table.headers.map((h, hi) => {
                const align = numericColSet.has(hi) ? 'text-right tabular-nums' : 'text-left';
                const colBorder = hi < colCount - 1 ? 'border-r border-gray-200' : '';
                const sticky = hi === 0 ? 'sticky-col bg-gray-50' : '';
                return linkCell
                  ? <th class={`px-3 py-2 font-medium text-gray-700 border-b whitespace-nowrap cursor-pointer hover:bg-gray-100 select-none ${align} ${colBorder} ${sticky}`} data-col={hi} data-numeric={numericColSet.has(hi)}><span set:html={linkCell(columnHeaderLabel(h))} /><span class="sort-arrow ml-1 text-gray-400"></span></th>
                  : <th class={`px-3 py-2 font-medium text-gray-700 border-b whitespace-nowrap cursor-pointer hover:bg-gray-100 select-none ${align} ${colBorder} ${sticky}`} data-col={hi} data-numeric={numericColSet.has(hi)}>{columnHeaderLabel(h)}<span class="sort-arrow ml-1 text-gray-400"></span></th>;
              })}
            </tr>
          </thead>
        )}
        <tbody>
          {table.rows.map((row, i) => {
            const section = sections[i] || '';
            const prevSection = i > 0 ? (sections[i - 1] || '') : '';
            const showDivider = section && section !== prevSection;
            const isSectionRow = showDivider && row[0]?.trim() === section;
            const isTotal = isTotalRow(row);
            const rowBg = isSectionRow
              ? 'bg-ps-yellow-50'
              : isTotal
                ? 'bg-gray-100'
                : i % 2 === 0 ? 'bg-white' : 'bg-gray-50';

            return (
              <>
                {showDivider && !isSectionRow && (
                  <tr class="bg-ps-yellow-50 border-t-2 border-ps-yellow-200" data-row-type="divider" data-section={section} data-orig-index={i}>
                    {linkCell
                      ? <td colspan={colCount} class="px-3 py-1.5 text-xs font-semibold text-ps-yellow-800 uppercase tracking-wide" set:html={linkCell(section)} />
                      : <td colspan={colCount} class="px-3 py-1.5 text-xs font-semibold text-ps-yellow-800 uppercase tracking-wide">{section}</td>
                    }
                  </tr>
                )}
                <tr class={
                  isSectionRow
                    ? 'bg-ps-yellow-50 border-t-2 border-ps-yellow-200 font-semibold text-ps-yellow-900'
                    : isTotal
                      ? 'bg-gray-100 border-t-2 border-gray-300 font-semibold text-gray-900'
                      : i % 2 === 0 ? 'bg-white' : 'bg-gray-50'
                } data-section={section} data-orig-index={i} data-row-type={
                  isSectionRow ? 'section-header' : isTotal ? 'total' : 'data'
                }>
                  {row.map((cell, ci) => {
                    const align = numericColSet.has(ci) ? 'text-right tabular-nums' : '';
                    const change = cellChangeClass[i]?.[ci] || '';
                    const colBorder = ci < colCount - 1 ? 'border-r border-gray-200' : '';
                    const sticky = ci === 0 ? `sticky-col ${rowBg}` : '';
                    const amd = amendmentCell[i]?.[ci];
                    const amdClass = amd ? amd.cls : '';
                    const tip = amd ? amd.tip : undefined;
                    const tabindex = amd ? '0' : undefined;
                    return linkCell && ci === 0
                      ? <td class={`px-3 py-1.5 border-b border-gray-100 whitespace-nowrap ${align} ${change} ${amdClass} ${colBorder} ${sticky}`} data-amendment-tip={tip} tabindex={tabindex} set:html={linkCell(cell)} />
                      : <td class={`px-3 py-1.5 border-b border-gray-100 whitespace-nowrap ${align} ${change} ${amdClass} ${colBorder} ${sticky}`} data-amendment-tip={tip} tabindex={tabindex}>{cell}</td>;
                  })}
                </tr>
              </>
            );
          })}
        </tbody>
      </table>
    </div>
    <div class="scroll-shadow-right" aria-hidden="true"></div>
    <div class="scroll-hint" aria-hidden="true">swipe →</div>
  </div>
</div>

<style>
  .sticky-col {
    position: sticky;
    left: 0;
    z-index: 1;
  }
  .scroll-shadow-right {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 24px;
    pointer-events: none;
    background: linear-gradient(to right, rgba(15, 23, 42, 0), rgba(15, 23, 42, 0.35));
    opacity: 0;
    transition: opacity 0.15s ease;
  }
  .table-scroll-wrap.can-scroll-right .scroll-shadow-right {
    opacity: 1;
  }
  /* "swipe →" badge at the top-right of the table; visible at first paint */
  .scroll-hint {
    position: absolute;
    top: 8px;
    right: 8px;
    pointer-events: none;
    background: rgba(15, 23, 42, 0.85);
    color: #fff;
    font-size: 11px;
    font-weight: 500;
    line-height: 1;
    padding: 5px 9px;
    border-radius: 9999px;
    z-index: 2;
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .table-scroll-wrap.can-scroll-right.is-scrolled-pristine .scroll-hint {
    opacity: 1;
  }
  /* Hide the explicit hint on wide viewports — affordance not needed */
  @media (min-width: 768px) {
    .scroll-hint { display: none; }
  }
  /* Subtle right-edge separator on the sticky column when scrolled */
  .table-scroll-wrap.is-scrolled .sticky-col {
    box-shadow: 1px 0 0 0 rgba(0, 0, 0, 0.08);
  }
</style>

<script>
  // Toggle scroll-affordance classes based on horizontal scroll position.
  function updateTableScrollState(wrap: HTMLElement) {
    const inner = wrap.querySelector('.overflow-x-auto') as HTMLElement | null;
    if (!inner) return;
    const max = inner.scrollWidth - inner.clientWidth;
    const left = inner.scrollLeft;
    wrap.classList.toggle('can-scroll-right', max > 1 && left < max - 1);
    wrap.classList.toggle('is-scrolled', left > 1);
    // "Pristine" = scrollable but user hasn't scrolled yet — show the swipe hint.
    wrap.classList.toggle('is-scrolled-pristine', max > 1 && left <= 1);
  }

  function initTableScrollWrap(wrap: HTMLElement) {
    const inner = wrap.querySelector('.overflow-x-auto') as HTMLElement | null;
    if (!inner) return;
    updateTableScrollState(wrap);
    inner.addEventListener('scroll', () => updateTableScrollState(wrap), { passive: true });
    const ro = new ResizeObserver(() => updateTableScrollState(wrap));
    ro.observe(inner);
  }

  for (const wrap of document.querySelectorAll<HTMLElement>('.table-scroll-wrap')) {
    initTableScrollWrap(wrap);
  }
</script>

<script>
  // Copy table handler
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.copy-table-btn') as HTMLButtonElement | null;
    if (!btn) return;
    const tableId = btn.dataset.tableId;
    const container = document.getElementById(`table-container-${tableId}`);
    const table = container?.querySelector('table');
    if (!table) return;

    const rows: string[] = [];
    for (const tr of table.querySelectorAll('tr')) {
      const cells: string[] = [];
      for (const cell of tr.querySelectorAll('th, td')) {
        cells.push((cell as HTMLElement).innerText.trim());
      }
      if (cells.some(c => c)) rows.push(cells.join('\t'));
    }
    navigator.clipboard.writeText(rows.join('\n')).then(() => {
      const orig = btn.textContent;
      btn.textContent = 'Copied!';
      setTimeout(() => { btn.textContent = orig; }, 1500);
    });
  });

  // Floating tooltip for amendment cells. A single body-level fixed element
  // escapes the table's overflow/sticky clipping. Bound once per page.
  if (!(window as any).__amendmentTooltipInit) {
    (window as any).__amendmentTooltipInit = true;
    let tip: HTMLDivElement | null = null;
    const ensureTip = (): HTMLDivElement => {
      if (!tip) {
        tip = document.createElement('div');
        tip.id = 'amendment-tooltip';
        tip.setAttribute('role', 'tooltip');
        document.body.appendChild(tip);
      }
      return tip;
    };
    const show = (cell: HTMLElement) => {
      const text = cell.getAttribute('data-amendment-tip');
      if (!text) return;
      const t = ensureTip();
      t.textContent = text;
      t.classList.add('visible');
      const r = cell.getBoundingClientRect();
      const tr = t.getBoundingClientRect();
      let left = r.left + r.width / 2 - tr.width / 2;
      left = Math.max(8, Math.min(left, window.innerWidth - tr.width - 8));
      let top = r.top - tr.height - 8;
      if (top < 8) top = r.bottom + 8;
      t.style.left = `${left}px`;
      t.style.top = `${top}px`;
    };
    const hide = () => { if (tip) tip.classList.remove('visible'); };
    const cellFrom = (e: Event): HTMLElement | null =>
      (e.target as HTMLElement)?.closest?.('[data-amendment-tip]') as HTMLElement | null;
    document.addEventListener('mouseover', (e) => { const c = cellFrom(e); if (c) show(c); });
    document.addEventListener('mouseout', (e) => { if (cellFrom(e)) hide(); });
    document.addEventListener('focusin', (e) => { const c = cellFrom(e); if (c) show(c); });
    document.addEventListener('focusout', hide);
    document.addEventListener('click', (e) => { const c = cellFrom(e); if (c) show(c); else hide(); });
    window.addEventListener('scroll', hide, true);
  }

  // Column sort handler
  const sortStates = new WeakMap<HTMLTableElement, { col: number; dir: 'asc' | 'desc' | null }>();

  function parseNumeric(text: string): number {
    const s = text.trim();
    if (!s || s === '—' || s === '-') return NaN;
    const neg = s.startsWith('(') || s.startsWith('-');
    const num = parseFloat(s.replace(/[$,()]/g, ''));
    return neg ? -Math.abs(num) : num;
  }

  document.addEventListener('click', (e) => {
    const th = (e.target as HTMLElement).closest('th[data-col]') as HTMLElement | null;
    if (!th) return;
    e.preventDefault();
    e.stopPropagation();
    const table = th.closest('table');
    if (!table) return;
    const tbody = table.querySelector('tbody');
    if (!tbody) return;

    const col = parseInt(th.dataset.col!, 10);
    const isNumeric = th.dataset.numeric === 'true';
    const state = sortStates.get(table) || { col: -1, dir: null };

    // Cycle: asc -> desc -> reset
    let dir: 'asc' | 'desc' | null;
    if (state.col === col) {
      dir = state.dir === 'asc' ? 'desc' : state.dir === 'desc' ? null : 'asc';
    } else {
      dir = 'asc';
    }
    sortStates.set(table, { col, dir });

    // Update sort arrows
    for (const arrow of table.querySelectorAll('.sort-arrow')) {
      arrow.textContent = '';
    }
    if (dir) {
      const activeArrow = th.querySelector('.sort-arrow');
      if (activeArrow) activeArrow.textContent = dir === 'asc' ? ' \u25B2' : ' \u25BC';
    }

    const allRows = Array.from(tbody.querySelectorAll('tr'));
    if (!dir) {
      // Reset to original order
      allRows.sort((a, b) => {
        const ai = parseInt(a.dataset.origIndex || '0', 10);
        const bi = parseInt(b.dataset.origIndex || '0', 10);
        return ai - bi;
      });
      for (const row of allRows) tbody.appendChild(row);
      return;
    }

    // Group rows by section, preserving group order
    type RowGroup = { section: string; rows: HTMLTableRowElement[] };
    const groups: RowGroup[] = [];
    let currentGroup: RowGroup | null = null;
    for (const row of allRows) {
      const section = row.dataset.section || '';
      if (!currentGroup || currentGroup.section !== section) {
        currentGroup = { section, rows: [] };
        groups.push(currentGroup);
      }
      currentGroup.rows.push(row);
    }

    // Sort within each group
    for (const group of groups) {
      const pinned: HTMLTableRowElement[] = [];
      const sortable: HTMLTableRowElement[] = [];
      const totals: HTMLTableRowElement[] = [];
      for (const row of group.rows) {
        const type = row.dataset.rowType;
        if (type === 'divider' || type === 'section-header') {
          pinned.push(row);
        } else if (type === 'total') {
          totals.push(row);
        } else {
          sortable.push(row);
        }
      }

      sortable.sort((a, b) => {
        const aText = (a.children[col] as HTMLElement)?.innerText?.trim() || '';
        const bText = (b.children[col] as HTMLElement)?.innerText?.trim() || '';
        if (isNumeric) {
          const na = parseNumeric(aText), nb = parseNumeric(bText);
          const nanA = isNaN(na), nanB = isNaN(nb);
          if (nanA && nanB) return 0;
          if (nanA) return 1;
          if (nanB) return -1;
          return dir === 'asc' ? na - nb : nb - na;
        }
        const cmp = aText.localeCompare(bText, undefined, { sensitivity: 'base' });
        return dir === 'asc' ? cmp : -cmp;
      });

      group.rows = [...pinned, ...sortable, ...totals];
    }

    // Re-append all rows in new order
    for (const group of groups) {
      for (const row of group.rows) tbody.appendChild(row);
    }
  });
</script>
