---
import PageImage from './PageImage.tsx';

interface Props {
  table: {
    id: string;
    relative_page: number;
    table_index: number;
    table_type: string;
    headers: string[];
    rows: string[][];
    sections?: string[];
    absolute_page?: number;
    description?: string;
  };
  slug?: string;
  linkCell?: (text: string) => string;
}

const { table, slug, linkCell } = Astro.props;

import { TYPE_COLORS, typeDescription } from '../lib/type-colors';

const badgeClass = TYPE_COLORS[table.table_type] || TYPE_COLORS.unknown;
const annotation = table.description || typeDescription(table.table_type);
const sections = table.sections || [];
const colCount = table.headers.length;

// Detect numeric columns: columns where >50% of non-empty values look numeric/currency
const numericColSet = new Set<number>();
for (let ci = 0; ci < colCount; ci++) {
  let numCount = 0;
  let total = 0;
  for (const row of table.rows) {
    const cell = (row[ci] || '').trim();
    if (!cell) continue;
    total++;
    if (/^[\$\(]?[\d,]+(\.\d+)?[\)]?$/.test(cell) || cell === '—') numCount++;
  }
  if (total > 0 && numCount / total > 0.5) numericColSet.add(ci);
}

function isTotalRow(row: string[]): boolean {
  const cell = (row[0] || '').trim().toLowerCase();
  return cell.startsWith('total') || cell.endsWith('total');
}
---

<div class="mb-8 bg-white rounded-lg border overflow-hidden" id={`table-container-${table.id}`}>
  <div class="px-4 py-3 bg-gray-50 border-b text-sm">
    <div class="flex items-center gap-3">
      <span class={`px-2 py-0.5 rounded text-xs font-medium ${badgeClass}`}>
        {table.table_type}
      </span>
      <span class="text-gray-500">
        Page {table.relative_page}, Table {table.table_index}
        {table.absolute_page ? ` (p. ${table.absolute_page} in full PDF)` : ''}
      </span>
      {slug && (
        <PageImage client:load slug={slug} page={table.relative_page} />
      )}
      <button
        class="ml-auto text-xs text-gray-400 hover:text-blue-600 print:hidden copy-table-btn"
        data-table-id={table.id}
        title="Copy table as tab-separated text"
        aria-label="Copy table"
      >
        Copy table
      </button>
    </div>
    <p class="text-xs text-gray-400 italic mt-1">{annotation}</p>
  </div>
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      {table.headers.length > 0 && (
        <thead>
          <tr class="bg-gray-50">
            {table.headers.map((h, hi) => {
              const align = numericColSet.has(hi) ? 'text-right tabular-nums' : 'text-left';
              return linkCell
                ? <th class={`px-3 py-2 font-medium text-gray-700 border-b whitespace-nowrap cursor-pointer hover:bg-gray-100 select-none ${align}`} data-col={hi} data-numeric={numericColSet.has(hi)}><span set:html={linkCell(h)} /><span class="sort-arrow ml-1 text-gray-400"></span></th>
                : <th class={`px-3 py-2 font-medium text-gray-700 border-b whitespace-nowrap cursor-pointer hover:bg-gray-100 select-none ${align}`} data-col={hi} data-numeric={numericColSet.has(hi)}>{h}<span class="sort-arrow ml-1 text-gray-400"></span></th>;
            })}
          </tr>
        </thead>
      )}
      <tbody>
        {table.rows.map((row, i) => {
          const section = sections[i] || '';
          const prevSection = i > 0 ? (sections[i - 1] || '') : '';
          const showDivider = section && section !== prevSection;
          const isSectionRow = showDivider && row[0]?.trim() === section;
          const isTotal = isTotalRow(row);

          return (
            <>
              {showDivider && !isSectionRow && (
                <tr class="bg-amber-50 border-t-2 border-amber-200" data-row-type="divider" data-section={section} data-orig-index={i}>
                  {linkCell
                    ? <td colspan={colCount} class="px-3 py-1.5 text-xs font-semibold text-amber-800 uppercase tracking-wide" set:html={linkCell(section)} />
                    : <td colspan={colCount} class="px-3 py-1.5 text-xs font-semibold text-amber-800 uppercase tracking-wide">{section}</td>
                  }
                </tr>
              )}
              <tr class={
                isSectionRow
                  ? 'bg-amber-50 border-t-2 border-amber-200 font-semibold text-amber-900'
                  : isTotal
                    ? 'bg-gray-100 border-t-2 border-gray-300 font-semibold text-gray-900'
                    : i % 2 === 0 ? 'bg-white' : 'bg-gray-50'
              } data-section={section} data-orig-index={i} data-row-type={
                isSectionRow ? 'section-header' : isTotal ? 'total' : 'data'
              }>
                {row.map((cell, ci) => {
                  const align = numericColSet.has(ci) ? 'text-right tabular-nums' : '';
                  return linkCell && ci === 0
                    ? <td class={`px-3 py-1.5 border-b border-gray-100 whitespace-nowrap ${align}`} set:html={linkCell(cell)} />
                    : <td class={`px-3 py-1.5 border-b border-gray-100 whitespace-nowrap ${align}`}>{cell}</td>;
                })}
              </tr>
            </>
          );
        })}
      </tbody>
    </table>
  </div>
</div>

<script>
  // Copy table handler
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.copy-table-btn') as HTMLButtonElement | null;
    if (!btn) return;
    const tableId = btn.dataset.tableId;
    const container = document.getElementById(`table-container-${tableId}`);
    const table = container?.querySelector('table');
    if (!table) return;

    const rows: string[] = [];
    for (const tr of table.querySelectorAll('tr')) {
      const cells: string[] = [];
      for (const cell of tr.querySelectorAll('th, td')) {
        cells.push((cell as HTMLElement).innerText.trim());
      }
      if (cells.some(c => c)) rows.push(cells.join('\t'));
    }
    navigator.clipboard.writeText(rows.join('\n')).then(() => {
      const orig = btn.textContent;
      btn.textContent = 'Copied!';
      setTimeout(() => { btn.textContent = orig; }, 1500);
    });
  });

  // Column sort handler
  const sortStates = new WeakMap<HTMLTableElement, { col: number; dir: 'asc' | 'desc' | null }>();

  function parseNumeric(text: string): number {
    const s = text.trim();
    if (!s || s === '—' || s === '-') return NaN;
    const neg = s.startsWith('(') || s.startsWith('-');
    const num = parseFloat(s.replace(/[$,()]/g, ''));
    return neg ? -Math.abs(num) : num;
  }

  document.addEventListener('click', (e) => {
    const th = (e.target as HTMLElement).closest('th[data-col]') as HTMLElement | null;
    if (!th) return;
    e.preventDefault();
    e.stopPropagation();
    const table = th.closest('table');
    if (!table) return;
    const tbody = table.querySelector('tbody');
    if (!tbody) return;

    const col = parseInt(th.dataset.col!, 10);
    const isNumeric = th.dataset.numeric === 'true';
    const state = sortStates.get(table) || { col: -1, dir: null };

    // Cycle: asc -> desc -> reset
    let dir: 'asc' | 'desc' | null;
    if (state.col === col) {
      dir = state.dir === 'asc' ? 'desc' : state.dir === 'desc' ? null : 'asc';
    } else {
      dir = 'asc';
    }
    sortStates.set(table, { col, dir });

    // Update sort arrows
    for (const arrow of table.querySelectorAll('.sort-arrow')) {
      arrow.textContent = '';
    }
    if (dir) {
      const activeArrow = th.querySelector('.sort-arrow');
      if (activeArrow) activeArrow.textContent = dir === 'asc' ? ' \u25B2' : ' \u25BC';
    }

    const allRows = Array.from(tbody.querySelectorAll('tr'));
    if (!dir) {
      // Reset to original order
      allRows.sort((a, b) => {
        const ai = parseInt(a.dataset.origIndex || '0', 10);
        const bi = parseInt(b.dataset.origIndex || '0', 10);
        return ai - bi;
      });
      for (const row of allRows) tbody.appendChild(row);
      return;
    }

    // Group rows by section, preserving group order
    type RowGroup = { section: string; rows: HTMLTableRowElement[] };
    const groups: RowGroup[] = [];
    let currentGroup: RowGroup | null = null;
    for (const row of allRows) {
      const section = row.dataset.section || '';
      if (!currentGroup || currentGroup.section !== section) {
        currentGroup = { section, rows: [] };
        groups.push(currentGroup);
      }
      currentGroup.rows.push(row);
    }

    // Sort within each group
    for (const group of groups) {
      const pinned: HTMLTableRowElement[] = [];
      const sortable: HTMLTableRowElement[] = [];
      const totals: HTMLTableRowElement[] = [];
      for (const row of group.rows) {
        const type = row.dataset.rowType;
        if (type === 'divider' || type === 'section-header') {
          pinned.push(row);
        } else if (type === 'total') {
          totals.push(row);
        } else {
          sortable.push(row);
        }
      }

      sortable.sort((a, b) => {
        const aText = (a.children[col] as HTMLElement)?.innerText?.trim() || '';
        const bText = (b.children[col] as HTMLElement)?.innerText?.trim() || '';
        if (isNumeric) {
          const na = parseNumeric(aText), nb = parseNumeric(bText);
          const nanA = isNaN(na), nanB = isNaN(nb);
          if (nanA && nanB) return 0;
          if (nanA) return 1;
          if (nanB) return -1;
          return dir === 'asc' ? na - nb : nb - na;
        }
        const cmp = aText.localeCompare(bText, undefined, { sensitivity: 'base' });
        return dir === 'asc' ? cmp : -cmp;
      });

      group.rows = [...pinned, ...sortable, ...totals];
    }

    // Re-append all rows in new order
    for (const group of groups) {
      for (const row of group.rows) tbody.appendChild(row);
    }
  });
</script>
