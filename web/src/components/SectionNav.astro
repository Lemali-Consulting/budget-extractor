---
/**Prev/next navigation bar for moving between sections within a budget type.*/

interface Props {
  prev?: { slug: string; title: string } | null;
  next?: { slug: string; title: string } | null;
  basePath: string; // e.g. "/sections" or "/capital"
  position?: 'top' | 'bottom';
}

const { prev, next, basePath, position = 'bottom' } = Astro.props;
const isTop = position === 'top';
const wrapperClass = isTop
  ? 'mb-6 pb-4 border-b border-gray-200 flex items-stretch gap-4'
  : 'mt-12 pt-6 border-t border-gray-200 flex items-stretch gap-4';
---

{(prev || next) && (
  <nav class={wrapperClass}>
    {prev ? (
      <a
        href={`${basePath}/${prev.slug}/`}
        class="flex-1 group flex items-start gap-2 px-4 py-3 rounded-lg border border-gray-200 hover:border-blue-300 hover:bg-blue-50 transition text-left"
      >
        <span class="text-gray-400 group-hover:text-blue-500 mt-0.5 shrink-0" aria-hidden="true">&larr;</span>
        <span>
          <span class="block text-xs text-gray-400 group-hover:text-blue-500">Previous</span>
          <span class="block text-sm font-medium text-gray-700 group-hover:text-blue-700 line-clamp-2">{prev.title}</span>
        </span>
      </a>
    ) : (
      <div class="flex-1"></div>
    )}
    {next ? (
      <a
        href={`${basePath}/${next.slug}/`}
        class="flex-1 group flex items-start gap-2 px-4 py-3 rounded-lg border border-gray-200 hover:border-blue-300 hover:bg-blue-50 transition text-right justify-end"
      >
        <span class="text-right">
          <span class="block text-xs text-gray-400 group-hover:text-blue-500">Next</span>
          <span class="block text-sm font-medium text-gray-700 group-hover:text-blue-700 line-clamp-2">{next.title}</span>
        </span>
        <span class="text-gray-400 group-hover:text-blue-500 mt-0.5 shrink-0" aria-hidden="true">&rarr;</span>
      </a>
    ) : (
      <div class="flex-1"></div>
    )}
  </nav>
)}
