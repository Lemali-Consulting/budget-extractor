---
/**
 * Slim banner noting that a year's operating figures reflect an amended budget.
 * Renders only for years that have amendment data; the date lives in the data.
 */
import type { BudgetYear } from '../lib/budget-year';

interface Props {
  budgetYear: BudgetYear;
  showLink?: boolean;
}
const { budgetYear, showLink = true } = Astro.props;
const amendment = budgetYear.amendment;
---

{amendment && (
  <div class="mb-6 border-l-4 border-ps-yellow-400 bg-ps-yellow-50 rounded-r-lg px-4 py-2.5 text-sm text-ps-yellow-900 print:hidden">
    <span aria-hidden="true" class="mr-1">&#9888;&#65039;</span>
    {budgetYear.year} operating figures reflect the budget <strong>{amendment.documentLabel}</strong>.
    {showLink && (
      <a href={amendment.path} class="font-medium underline hover:text-ps-yellow-700">See what changed &rarr;</a>
    )}
  </div>
)}
