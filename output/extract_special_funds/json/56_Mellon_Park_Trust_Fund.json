  "metadata": {
    "fund_code": "5000283300",
    "fund_name": "Mellon Park Trust Fund",
    "department": "Department of Parks and Recreation",
    "authorizing_legislation": "633 of 2002, as amended by 753 of 2016",
    "description": "The trust fund pays for tennis instructors, payroll expenses, maintenance to the Bubble, and to supplement the payment of administrative and operational costs in connection improvements to Mellon Park, Citiparks' indoor tennis program, and/or other Citiparks indoor tennis facilities.",
    "revenues_description": "Any funds received from the Mellon Park support structure and indoor tennis facilities.",
    "expenditures_description": "To supplement the payments of various administrative and operational costs in connection with improvements to Mellon Park, Citiparks indoor tennis program and/or other Citiparks indoor tennis facilities. Parks and Recreation shall at all times set aside reserve funding within this trust fund to provide for the replacement or repair of any and all existing indoor facilities within two years of construction or replacement.",
