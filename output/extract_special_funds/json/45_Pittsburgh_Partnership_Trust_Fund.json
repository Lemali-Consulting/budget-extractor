  "metadata": {
    "fund_code": "1090230000",
    "fund_name": "Pittsburgh Partnership Trust Fund",
    "department": "Human Resources and Civil Service",
    "authorizing_legislation": "432 of 1974, as amended by every annual grant application.",
    "description": "The Pittsburgh Partnership provides employment and training services designed to help City of Pittsburgh residents become attached or reattached to the labor force. The Pittsburgh Partnership Trust Fund is used to administer these services. This fund was previously known as the Job Training Partnership Act (JTPA) trust fund, the Workforce Investment Act (WIA) trust fund, and the Comprehensive Employment and Training Act (CETA) trust fund.",
    "revenues_description": "Grants from the United States Department of Labor and the Pennsylvania Department of Human Services, as well as targeted City Community Development and Block Grant funds.",
    "expenditures_description": "All costs relating to the Employment and Retention Network (EARN) program and the Learn and Earn Summer Youth Employment initiative, including salaries, wages, and benefits for personnel, as well as office supplies, professional services, rental fees, and grant payments related to these programs.",
